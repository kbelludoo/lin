{
  "benchmark": "FIRE_TEST_004_JQ",
  "version": "1.0.0",
  "target_product": "jq (C Implementation v1.7.1) vs LIN-jq",
  "title": "Complete Real-World CLI Product Benchmark: Original C jq vs LIN-jq",
  "goal": "Re-implement the core jq query engine and streaming CLI in LIN Native Workflow (@LIN:L2w:1.0), compiling to native Rust/Zig/C binaries and proving 100% official query test suite parity, lower cold start, higher throughput on multi-GB JSON streams, lower peak RSS, and superior agent maintainability.",
  "freeze_before_execution": true,
  "jq_features_evaluated": [
