      "syntax": ".[] , .[2:5], length, map(.)",
      "description": "Array slicing, iteration, and mapping"
    },
    {
      "id": "pipe_and_composition",
      "syntax": ".foo | .bar | map(.id)",
      "description": "Composition pipelines and multi-stage queries"
    },
    {
      "id": "filters_and_conditionals",
      "syntax": "select(.age > 30), if .a then .b else .c end",
      "description": "Predicates, boolean logic, and branching"
    },
    {
      "id": "aggregations",
      "syntax": "group_by(.), sort_by(.), unique, reduce",
      "description": "Complex multi-pass aggregation algorithms"
    },
    {
      "id": "streaming_mode",
      "syntax": "jq --stream",
      "description": "Streaming JSON token parser with zero full-document buffering"
