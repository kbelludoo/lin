@LIA:REPO:1.3.0

^name="lia-lang"
^path="C:/Users/k/Documents/lia"
^role="canonical_LIA_language_repository"
^formerly="ail / ail-lang"
^rule=AIs_MUST_WRITE_CODE_IN_LIA
^goal="supersede_Dicel_plus_auto_improve_evolve"
^compile="LIA_multi_emit"
^dicel="legacy_archive_only"
^LIA_gate="ge_Dicel"

@LAYOUT {
  spec: "LIA_MULTI_EMIT + LIA_AUTONOMY + LIA_SUPERSEDES_DICEL + semantics + compiler"
  src: "emitter + compiler + emit_{js,ts,py,go,rust} + multi_emit"
  bin: "lia CLI (ail alias)"
  examples: "safe-compare.lia bytes.lia"
  tests: "roundtrip + golden_multi_emit"
  scripts: "self_repair + evolve_loop + clone_lia_loop + bench + golden_multi_emit"
  storage: "ledger trauma knowledge hypotheses"
  agents: "AGENTS.md + spec/LIA_AGENT_RULE.dicel"
  rename: "LIA_RENAME.dicel"
}

@LEGEND {
  line: "!fn ?if #for ^ret :else $K=consts =ex=exports ~G=grammar"
}

@HEADERS {
  emit_default: "@LIA:L1c:0.2"
  dual_read: "@LIA + legacy @AIL"
}

@COMMANDS {
  test: "npm test"
  test_multi: "npm run test:multi"
  emit: "node bin/lia.mjs emit <js>"
  compile: "node bin/lia.mjs compile <lia> --target js|ts|py|go|rust"
  check: "node bin/lia.mjs check <lia>"
  improve: "node bin/lia.mjs improve"
  evolve: "node bin/lia.mjs evolve"
  autonomy_status: "node bin/lia.mjs autonomy-status"
  clone_lia: "node bin/lia.mjs clone-lia --source <url|path> [--name slug]"
  self_repair: "node scripts/self_repair.mjs --smoke"
}

@AUTONOMY {
  contract: "spec/LIA_SUPERSEDES_DICEL.rulel"
  spec: "spec/LIA_AUTONOMY.dicel"
  repair: "spec/LIA_SELF_REPAIR.dicel"
  clone_loop: "spec/LIA_CLONE_LIA_LOOP.dicel"
  script: "scripts/evolve_loop.mjs"
  clone_script: "scripts/clone_lia_loop.mjs"
  storage: "storage/lia_{ledger,trauma,knowledge,hypotheses}.dicel"
  policy: "on_error=FIX_COMPILER_NOT_LIA; LIA_ge_Dicel; ^immutable_core; @FORBID{mutate_lia_nucleus}"
}

@SELF_REPAIR {
  spec: "spec/LIA_SELF_REPAIR.dicel"
  prior_art: "spec/LIA_SELF_REPAIR_PRIOR_ART.dicel"
  script: "scripts/self_repair.mjs"
  report: "INTEL_LIA_SELF_REPAIR_MVP.dicel"
}
