@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_lua
~G{?=if #=for ^=ret :else}

!luaRetType(fn,stmts){rets=[];walk=(list)=>{#(i=0;i<(list||[]).length;i++){st=list[i];?(st.type==='return'){e=String(st.expr||'').trim();?(e.charAt(0)==='('&&e.charAt(e.length-1)===')'){e=e.slice(1,-1)};rets.push(e)};?(st.then){walk(st.then)};?(st.else){walk(st.else)};?(st.body){walk(st.body)}}};walk(stmts);?(rets.length===0){^'nil'};?(rets.every((t)=>/^(true|false)$/.test(t)||/(==|~=|<=|>=|<|>)/.test(t))){^'boolean'};?(rets.every((t)=>/^-?\d+$/.test(t)||isNumishId(t))){^'number'};?(rets.every((t)=>isStringishId(t)||/_lia_cat/.test(t))){^'string'};^'nil'}

!luaParamType(raw){name=raw.split(':')[0].trim();?(isNumishId(name)){^'number'};?(isBoolishId(name)){^'boolean'};?(isStringishId(name)){^'string'};^'nil'}

!emitLAssign(st,pad){lines=[];lines.push(pad+rewriteExpr(st.id,'lua')+' '+st.op+' '+rewriteExpr(st.expr,'lua'));^lines}
!emitLReturn(st,pad){lines=[];lines.push(pad+'return '+rewriteExpr(st.expr,'lua'));^lines}
!emitLThrow(st,pad){lines=[];lines.push(pad+'error('+rewriteExpr(st.expr,'lua')+')');^lines}
!emitLExpr(st,pad){lines=[];lines.push(pad+rewriteExpr(st.expr,'lua'));^lines}

!emitLIf(st,pad,indent){lines=[];lines.push(pad+'if '+emitCond(st.cond,'lua')+' then');lines.push(...emitLStmts(st.then,indent+1));#(i=0;i<(st.elseIf||[]).length;i++){e=st.elseIf[i];lines.push(pad+'elseif '+emitCond(e.cond,'lua')+' then');lines.push(...emitLStmts(e.body,indent+1))};?(st.else&&st.else.length>0){lines.push(pad+'else');lines.push(...emitLStmts(st.else,indent+1))};lines.push(pad+'end');^lines}

!emitLFor(st,pad,indent){lines=[];ip=String(st.init||'').split('=');vn=ip[0]||'i';sv=ip[1]||'0';cp=String(st.cond||'').split(/[<>=!]+/);ev=cp[1]||'0';se=String(st.step||'');ss='1';?(se.indexOf('++')>=0){ss='1'};?(se.indexOf('--')>=0){ss='-1'};lines.push(pad+'for '+vn+' = '+rewriteExpr(sv,'lua')+', '+rewriteExpr(ev,'lua')+', '+ss+' do');lines.push(...emitLStmts(st.body,indent+1));lines.push(pad+'end');^lines}

!emitLWhile(st,pad,indent){lines=[];?(String(st.cond).trim()==='true'){lines.push(pad+'while true do');lines.push(...emitLStmts(st.body,indent+1));lines.push(pad+'end');return lines};lines.push(pad+'while '+emitCond(st.cond,'lua')+' do');lines.push(...emitLStmts(st.body,indent+1));lines.push(pad+'end');^lines}

!emitLStmts(stmts,indent){pad='  '.repeat(indent);lines=[];#(i=0;i<(stmts||[]).length;i++){st=stmts[i];?(st.type==='assign'){lines.push(...emitLAssign(st,pad))};?(st.type==='return'){lines.push(...emitLReturn(st,pad))};?(st.type==='throw'){lines.push(...emitLThrow(st,pad))};?(st.type==='if'){lines.push(...emitLIf(st,pad,indent))};?(st.type==='for'){lines.push(...emitLFor(st,pad,indent))};?(st.type==='while'){lines.push(...emitLWhile(st,pad,indent))};?(st.type==='expr'){lines.push(...emitLExpr(st,pad))}};^lines}

!emitLFn(fn){names=emitNameMap([fn]);luaName=names[fn.name];params=fn.params.split(',').map((p)=>p.trim());pl=params.map((p)=>safeEmitId(p)).join(', ');stmts=tryParseStmts(fn.body);?(stmts){emitted=emitLStmts(stmts,1);ret=luaRetType(fn,stmts);?(ret==='boolean'){emitted.push('  return false')};?(ret==='number'){emitted.push('  return 0')};?(ret==='string'){emitted.push('  return ""')};return 'local function '+luaName+'('+pl+')\n'+emitted.join('\n')+'\nend'};return 'local function '+luaName+'('+pl+') error("LIA_EMIT_LUA: JS-runtime-only") end'}

!emitLua(liaText){prog=parseLia(liaText);parts=['-- generated by lia multi-emit → lua'];#(i=0;i<prog.fns.length;i++){parts.push(emitLFn(prog.fns[i]))};H='\n-- Lua runtime helpers\nlocal _lia_obj=function()return{}end\nlocal _lia_cat=function(a,b)return tostring(a or "")..tostring(b or "")end\nlocal _lia_str=function(x)return tostring(x or "")end\nlocal _lia_num=function(x)return tonumber(x)or 0 end\nlocal _lia_abs=function(x)return math.abs(_lia_num(x))end\nlocal _lia_round=function(x)return math.floor(_lia_num(x)+0.5)end\nlocal _lia_len=function(x)if type(x)=="string"then return #x elseif type(x)=="table"then return #x else return 0 end end\nlocal _lia_typeof=function(x)return type(x)end\nlocal _lia_falsy=function(x)return x==nil or x==false or x==0 or x==""end\nlocal _lia_or=function(a,b)if _lia_falsy(a)then return b end return a end\nlocal _lia_isnan=function(x)return x~=x end\nlocal _lia_isfinite=function(x)return true end\nlocal _lia_at=function(s,i)s=tostring(s or "");i=_lia_num(i);if i<1 or i>#s then return "" end return string.sub(s,i,i)end\nlocal _lia_code_at=function(s,i)s=tostring(s or "");i=_lia_num(i);if i<1 or i>#s then return 0 end return string.byte(s,i)end\nlocal _lia_includes=function(s,sub)return string.find(tostring(s or ""),tostring(sub or ""),1,true)~=nil end\nlocal _lia_lower=function(x)return string.lower(tostring(x or ""))end\nlocal _lia_instanceof=function(x,y)return false end\nlocal _lia_set=function(obj,key,val)return val end\nlocal _lia_get=function(obj,key)return nil end\n';parts.push(H);^(JSON.stringify({code:parts.join('\n')+'\n',target:'lua'}))}

=ex{luaRetType,luaParamType,emitLAssign,emitLReturn,emitLThrow,emitLExpr,emitLIf,emitLFor,emitLWhile,emitLStmts,emitLFn,emitLua}
