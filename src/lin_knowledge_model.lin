@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=lin_knowledge_model
~G{?=if #=for ^=ret :else}

!mkKnowledge(id,source,domain,property,category,generator,oracle,expected){^({id:id,source:source,domain:domain,property:property,category:category,generator:generator,oracle:oracle,expected:expected,status:'untested',failureId:null,counterexample:null,validatedAt:null})}
!mkTestSpec(property,generator,generatorParams,oracle,expected,targets){^({property:property,generator:generator,params:generatorParams||{},oracle:oracle,expected:expected,targets:targets||[],programs:[]})}
!mkTestResult(program,passed,detail,hash){^({program:program,passed:passed,detail:detail||null,hash:hash||null})}
!mkValidationResult(entry,generated,oracleResults,passed){^({entry:entry,generated:generated,oracleResults:oracleResults,passed:passed})}
!hasSub(s,sub){^(String(s||'').indexOf(sub)>=0)}
!classifyDomain(property){s=String(property).toLowerCase();?(hasSub(s,'alpha')||hasSub(s,'renaming')||hasSub(s,'scope')||hasSub(s,'shadow')){^'language_semantics'};?(hasSub(s,'type')||hasSub(s,'operator')||hasSub(s,'effect')){^'language_semantics'};?(hasSub(s,'cross')||hasSub(s,'backend')||hasSub(s,'target')){^'backend_invariants'};?(hasSub(s,'compiler')||hasSub(s,'parse')||hasSub(s,'syntax')){^'compiler_invariants'};?(hasSub(s,'security')||hasSub(s,'eval')||hasSub(s,'access')){^'security'};^(hasSub(s,'runtime')||hasSub(s,'memory')){^'runtime'};^'edge_cases'}
!classifyCategory(property){s=String(property).toLowerCase();?(hasSub(s,'alpha')||hasSub(s,'renaming')){^'alpha_renaming'};?(hasSub(s,'type')&&hasSub(s,'preserv')){^'type_preservation'};?(hasSub(s,'cross')&&hasSub(s,'target')){^'cross_target_parity'};?(hasSub(s,'semantic')||hasSub(s,'hash')||hasSub(s,'equiv')){^'semantic_stability'};?(hasSub(s,'operator')||hasSub(s,'normaliz')){^'operator_normalization'};?(hasSub(s,'string')||hasSub(s,'literal')){^'string_literal_integrity'};?(hasSub(s,'constant')||hasSub(s,'const')||hasSub(s,'inline')){^'constant_inlining'};?(hasSub(s,'effect')||hasSub(s,'side')){^'effect_tracking'};?(hasSub(s,'parse')||hasSub(s,'syntax')){^'parse_roundtrip'};?(hasSub(s,'number')||hasSub(s,'numeric')||hasSub(s,'overflow')){^'numeric_edge_cases'};^(hasSub(s,'scope')||hasSub(s,'variable')){^'scope_correctness'}
!pickGenerator(cat){?(cat=='alpha_renaming'){^'rename_local'};?(cat=='string_literal_integrity'){^'string_reserved'};?(cat=='operator_normalization'){^'operator_chain'};?(cat=='constant_inlining'){^'constant_ref'};?(cat=='numeric_edge_cases'){^'boundary_values'};?(cat=='parse_roundtrip'){^'parse_roundtrip'};?(cat=='cross_target_parity'){^'cross_target'};^(cat=='effect_tracking'){^'effect_class'};^'parse_roundtrip'}
!pickOracle(cat){?(cat=='alpha_renaming'){^'semantic_hash'};?(cat=='type_preservation'){^'emit_success'};?(cat=='cross_target_parity'){^'differential'};?(cat=='string_literal_integrity'){^'parse_success'};?(cat=='constant_inlining'){^'execution_equality'};?(cat=='numeric_edge_cases'){^'execution_equality'};?(cat=='parse_roundtrip'){^'parse_success'};^(cat=='operator_normalization'){^'execution_equality'};^'parse_success'}
!extractKnowledge(aiOutput,source){entries=[];lines=strSplit(aiOutput,'\n');#(i=0;i<lines.length;i++){line=strReplace(lines[i],/^\s*[-*]\s*/,'').trim();?(strLen(line)>3){cat=classifyCategory(line);dom=classifyDomain(line);entries.push(mkKnowledge('K_'+source+'_'+i,source,dom,line,cat,pickGenerator(cat),pickOracle(cat),true))}};^entries}
!updateStatus(entry,passed,counterexample){entry.status=passed?'confirmed':'falsified';entry.counterexample=counterexample||null;entry.validatedAt=new Date().toISOString();^entry}
=ex{mkKnowledge,mkTestSpec,mkTestResult,mkValidationResult,hasSub,classifyDomain,classifyCategory,pickGenerator,pickOracle,extractKnowledge,updateStatus}
