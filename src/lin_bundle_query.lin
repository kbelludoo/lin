@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=lin_bundle_query
~G{?=if #=for ^=ret :else}

!listSymbols(bundle){?(bundle==null||bundle.modules==null){^[]};out=[];#(m=0;m<bundle.modules.length;m++){mod=bundle.modules[m];out.push({id:mod.id,effects:mod.effects,params:mod.signature.params.length,hash:mod.semantic_hash})};^out}
!findModule(bundle,name){mods=bundle.modules||[];#(i=0;i<mods.length;i++){?(mods[i].id==name){^mods[i]}};^null}
!findModulesByEffect(bundle,effect){mods=bundle.modules||[];out=[];#(m=0;m<mods.length;m++){#(e=0;e<mods[m].effects.length;e++){?(mods[m].effects[e]==effect){out.push(mods[m])}}};^out}
!resolveDeps(modules,mod){visited={};result=[];queue=[];#(c=0;c<mod.calls.length;c++){queue.push(mod.calls[c])};#(;queue.length>0;){name=queue.shift();?(visited[name]==1){continue};visited[name]=1;#(i=0;i<modules.length;i++){?(modules[i].id==name){result.push(modules[i]);#(cc=0;cc<modules[i].calls.length;cc++){queue.push(modules[i].calls[c])}}}};^result}
!querySymbol(bundle,name){mod=findModule(bundle,name);?(mod==null){^null};deps=resolveDeps(bundle.modules||[],mod);all=[mod];#(i=0;i<deps.length;i++){dup=0;#(j=0;j<all.length;j++){?(all[j].id==deps[i].id){dup=1}};?(dup==0){all.push(deps[i])}};^all}
!queryEffect(bundle,effect){^(findModulesByEffect(bundle,effect))}
!searchModules(bundle,term){mods=bundle.modules||[];out=[];t=String(term||'').toLowerCase();#(m=0;m<mods.length;m++){match=0;id=mods[m].id.toLowerCase();?(id.indexOf(t)>=0){match=1};#(e=0;e<mods[m].effects.length;e++){?(mods[m].effects[e].toLowerCase().indexOf(t)>=0){match=1}};#(c=0;c<mods[m].calls.length;c++){?(mods[m].calls[c].toLowerCase().indexOf(t)>=0){match=1}};?(match==1){out.push(mods[m])}};^out}
!partialLoadout(bundle,queryString){q=String(queryString||'').trim();type='search';target=q;pi=q.indexOf(':');?(pi>0){type=q.substring(0,pi).trim().toLowerCase();target=q.substring(pi+1).trim()};lc=type.toLowerCase();?(lc=='all'){type='all';target=null};results=[];?(type=='symbol'){results=querySymbol(bundle,target)};?(type=='effect'){results=queryEffect(bundle,target)};?(type=='module'){mod=findModule(bundle,target);?(mod){results=[mod]}};?(type=='deps'){mod=findModule(bundle,target);?(mod){results=resolveDeps(bundle.modules||[],mod)}};?(type=='search'){results=searchModules(bundle,target)};?(type=='all'){results=bundle.modules||[]};^({query:queryString,type:type,target:target,result_count:results.length,total_modules:(bundle.modules||[]).length,modules:results})}
!queryToContext(bundle,queryString){result=partialLoadout(bundle,queryString);lines=[];app=bundle.app||{};lines.push('# LIN App: '+(app.name||'?')+' v'+(app.version||'?'));lines.push('Semantic Hash: '+(bundle.semantic_hash||'?'));lines.push('Modules: '+String(result.result_count)+'/'+String(result.total_modules)+' | Query: '+queryString);lines.push('');#(m=0;m<result.modules.length;m++){mod=result.modules[m];params='';#(p=0;p<mod.signature.params.length;p++){?(p>0){params=params+', '};params=params+mod.signature.params[p].name+': '+mod.signature.params[p].type};ret=mod.signature.returns||'?';lines.push('- `'+mod.id+'`('+params+') -> '+ret+' ['+mod.effects.join(',')+'] hash:'+mod.semantic_hash);cl=mod.calls.length;?(cl>0){lines.push('  calls: '+mod.calls.join(', '))}};^(lines.join('\n')}
!buildEffectsIndex(bundle){mods=bundle.modules||[];idx={};#(m=0;m<mods.length;m++){#(e=0;e<mods[m].effects.length;e++){eff=mods[m].effects[e];?(idx[eff]==null){idx[eff]=[]};idx[eff].push(mods[m].id)}};^idx}
!buildTypeIndex(bundle){mods=bundle.modules||[];idx={};#(m=0;m<mods.length;m++){#(p=0;p<mods[m].signature.params.length;p++){ty=mods[m].signature.params[p].type;?(idx[ty]==null){idx[ty]=[]};idx[ty].push(mods[m].id)}};^idx}
=ex{listSymbols,findModule,findModulesByEffect,resolveDeps,querySymbol,queryEffect,searchModules,partialLoadout,queryToContext,buildEffectsIndex,buildTypeIndex}
