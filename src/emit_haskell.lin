@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_haskell
~G{?=if #=for ^=ret :else}

!hsRetType(fn,stmts){rets=[];walk=(list)=>{#(i=0;i<(list||[]).length;i++){st=list[i];?(st.type==='return'){e=String(st.expr||'').trim();?(e.charAt(0)==='('&&e.charAt(e.length-1)===')'){e=e.slice(1,-1)};rets.push(e)};?(st.then){walk(st.then)};?(st.else){walk(st.else)};?(st.body){walk(st.body)}}};walk(stmts);?(rets.length===0){^'()'};?(rets.every((t)=>/^(true|false)$/.test(t)||/(==|\/=|<=|>=|<|>)/.test(t))){^'Bool'};?(rets.every((t)=>/^-?\d+$/.test(t)||isNumishId(t))){^'Integer'};?(rets.every((t)=>isStringishId(t)||/_lia_cat/.test(t))){^'String'};^'Integer'}

!hsType(id){?(isNumishId(id)){^'Integer'};?(isBoolishId(id)){^'Bool'};?(isStringishId(id)){^'String'};^'a'}

!emitHAssign(st,pad){lines=[];lines.push(pad+st.id+' = '+rewriteExpr(st.expr,'haskell'));^lines}
!emitHReturn(st,pad){lines=[];lines.push(pad+rewriteExpr(st.expr,'haskell'));^lines}
!emitHThrow(st,pad){lines=[];lines.push(pad+'error '+rewriteExpr(st.expr,'haskell'));^lines}
!emitHExpr(st,pad){lines=[];lines.push(pad+rewriteExpr(st.expr,'haskell'));^lines}

!emitHIf(st,pad,indent){lines=[];lines.push(pad+'if '+emitCond(st.cond,'haskell'));lines.push(pad+'  then');lines.push(...emitHStmts(st.then,indent+2));?(st.else&&st.else.length>0){lines.push(pad+'  else');lines.push(...emitHStmts(st.else,indent+2))};^(lines)}

!emitHFor(st,pad,indent){lines=[];lines.push(pad+'-- for loop (imperative)');lines.push(...emitHStmts(st.body,indent));^(lines)}

!emitHWhile(st,pad,indent){lines=[];lines.push(pad+'-- while loop (imperative)');lines.push(...emitHStmts(st.body,indent));^(lines)}

!emitHStmts(stmts,indent){pad='  '.repeat(indent);lines=[];#(i=0;i<(stmts||[]).length;i++){st=stmts[i];?(st.type==='assign'){lines.push(...emitHAssign(st,pad))};?(st.type==='return'){lines.push(...emitHReturn(st,pad))};?(st.type==='throw'){lines.push(...emitHThrow(st,pad))};?(st.type==='if'){lines.push(...emitHIf(st,pad,indent))};?(st.type==='for'){lines.push(...emitHFor(st,pad,indent))};?(st.type==='while'){lines.push(...emitHWhile(st,pad,indent))};?(st.type==='expr'){lines.push(...emitHExpr(st,pad))}};^lines}

!emitHFn(fn){names=emitNameMap([fn]);hsName=names[fn.name];params=fn.params.split(',').map((p)=>p.trim());pl=params.map((p)=>safeEmitId(p));ts=pl.map((p)=>hsType(p));sig=hsName+' :: '+ts.join(' -> ')+' -> '+hsRetType(fn,tryParseStmts(fn.body)||[]);stmts=tryParseStmts(fn.body);?(stmts){emitted=emitHStmts(stmts,1);whereClause='';?(emitted.length>0){whereClause='  where\n'+emitted.join('\n')};return sig+'\n'+hsName+' '+pl.join(' ')+ ' = head []\n'+whereClause};return sig+'\n'+hsName+' '+pl.join(' ')+' = ()'}

!emitHaskell(liaText){prog=parseLia(liaText);parts=['-- generated by lia multi-emit → haskell','module Main where',''];#(i=0;i<prog.fns.length;i++){parts.push(emitHFn(prog.fns[i]))};^(JSON.stringify({code:parts.join('\n')+'\n',target:'haskell'}))}

=ex{hsRetType,hsType,emitHAssign,emitHReturn,emitHThrow,emitHExpr,emitHIf,emitHFor,emitHWhile,emitHStmts,emitHFn,emitHaskell}
