@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=lin_bundle
~G{?=if #=for ^=ret :else}

!linbFormat(){^'LINB/1'}
!mkParam(name,type){^({name:name,type:type})}
!mkContract(pre,post){^({pre:pre,post:post})}
!emptyContract(){^mkContract([],[])}
!hasSub(s,sub){^(String(s||'').indexOf(sub)>=0)}
!extractEffects(body){s=String(body||'');effs=[];?(hasSub(s,'throw')){effs.push('throw')};?(hasSub(s,'console.')){effs.push('io')};?(hasSub(s,'fetch(')){effs.push('network')};?(hasSub(s,'require(')){effs.push('module')};?(hasSub(s,'process.')){effs.push('system')};?(hasSub(s,'document.')||hasSub(s,'window.')){effs.push('dom')};?(hasSub(s,'setTimeout')||hasSub(s,'setInterval')){effs.push('async')};?(effs.length==0){effs.push('pure')};^effs}
!isIdentStart(c){code=c.charCodeAt(0);?(code>=97&&code<=122){^1};?(code>=65&&code<=90){^1};?(code==95){^1};^0}
!isIdentPart(c){code=c.charCodeAt(0);?(code>=97&&code<=122){^1};?(code>=65&&code<=90){^1};?(code>=48&&code<=57){^1};?(code==95){^1};^(code==36)}
!isKeyword(name){n=String(name||'');s=String(',if,else,while,for,return,throw,switch,case,var,let,const,typeof,function,new,in,of,');?(s.indexOf(','+n+',')>=0){^1};^0}
!extractCalls(body){calls=[];s=String(body||'');i=0;len=s.length;#(;i<len;){ch=s.charAt(i);?(isIdentStart(ch)==1){start=i;i++;#(;i<len;){ch2=s.charAt(i);?(isIdentPart(ch2)==1){i++}else{break}};word=s.slice(start,i);?(isKeyword(word)==0){j=i;#(;j<len&&s.charAt(j)==' '){j++};?(j<len&&s.charAt(j)=='('){dup=0;#(c=0;c<calls.length;c++){?(calls[c]==word){dup=1}};?(dup==0){calls.push(word)}}}};i++}};^calls}
!extractPreFromParams(params){pre=[];plist=String(params||'').split(',');#(i=0;i<plist.length;i++){p=plist[i].trim();?(hasSub(p,'{')&&hasSub(p,'}')){cb=p.indexOf('{');ce=p.indexOf('}');pn=p.substring(0,cb).replace(/:.+/,'').trim();constraint=p.substring(cb+1,ce).trim();pre.push(pn+' '+constraint)}};^pre}
!extractPostFromBody(body){post=[];s=String(body||'');i=0;#(;i<s.length;){?(s.charAt(i)=='^'){j=i+1;#(;j<s.length;){ch=s.charAt(j);?(ch==';'||ch=='}'||ch==')'){break};j++};expr=s.substring(i+1,j).trim();?(hasSub(expr,'===null')||hasSub(expr,'==null')){post.push('result==null')};?(hasSub(expr,'!==null')||hasSub(expr,'!=null')){post.push('result!=null')};i=j}else{i++}};^post}
!dedup(arr){seen={};out=[];#(i=0;i<arr.length;i++){v=String(arr[i]);?(seen[v]!=1){seen[v]=1;out.push(arr[i])}};^out}
!arrLen(a){?(a==null){^0};^(a.length)}
!packLinb(progJson,name,version,entrypointsJson){mods=progJson.fns||[];modules=[];symbols=[];allEffects=[];allTypes=[];contracts=[];#(i=0;i<mods.length;i++){fn=mods[i];effects=extractEffects(fn.body);calls=extractCalls(fn.body);params=[];plist=String(fn.params||'').split(',');#(j=0;j<plist.length;j++){pp=plist[j].trim();?(pp){colonIdx=pp.indexOf(':');?(colonIdx>=0){pn=pp.substring(0,colonIdx).trim();pt=pp.substring(colonIdx+1).trim()}else{pn=pp;pt='any'};params.push(mkParam(pn,pt));allTypes.push(pt)}};pre=extractPreFromParams(fn.params);post=extractPostFromBody(fn.body);hasContracts=arrLen(pre)>0||arrLen(post)>0;?(hasContracts){contracts.push({module:fn.id||fn.name,pre:pre,post:post})};modObj={id:fn.id||fn.name,kind:'function',signature:{params:params,returns:fn.returnType||'any'},effects:effects,calls:calls,contracts:mkContract(pre,post),semantic_hash:fn.hash||'',body_length:String(fn.body||'').length};modules.push(modObj);symbols.push({name:fn.id||fn.name,hash:fn.hash||'',effects:effects});#(e=0;e<effects.length;e++){allEffects.push(effects[e])}};allEffects=dedup(allEffects);allTypes=dedup(allTypes);entrypoints=entrypointsJson;?(entrypoints==null||arrLen(entrypoints)==0){entrypoints=[];#(i=0;i<modules.length;i++){entrypoints.push(modules[i].id)}};effectIndex=[];#(e=0;e<allEffects.length;e++){eff=allEffects[e];modIds=[];#(m=0;m<modules.length;m++){#(ef=0;ef<modules[m].effects.length;ef++){?(modules[m].effects[ef]==eff){modIds.push(modules[m].id)}}};effectIndex.push({name:eff,modules:modIds})};typeIndex=[];#(t=0;t<allTypes.length;t++){ty=allTypes[t];modIds=[];#(m=0;m<modules.length;m++){#(p=0;p<modules[m].signature.params.length;p++){?(modules[m].signature.params[p].type==ty){modIds.push(modules[m].id)}}};typeIndex.push({name:ty,usages:modIds})};depGraph={};#(m=0;m<modules.length;m++){mid=modules[m].id;deps=[];#(c=0;c<modules[m].calls.length;c++){callName=modules[m].calls[c];#(x=0;x<modules.length;x++){?(modules[x].id==callName){deps.push(callName)}}};depGraph[mid]=deps};^({format:linbFormat(),app:{name:name||'unnamed',version:version||'0.0.0'},semantic_hash:progJson.semantic_hash||'',source_header:progJson.header||'',modules:modules,symbols:symbols,types:typeIndex,effects:effectIndex,contracts:contracts,dependencies:depGraph,entrypoints:entrypoints,consts:progJson.consts||null,exports:progJson.exports||[]})}
!unpackToLin(bundle){?(bundle==null||bundle.format!=linbFormat()){^null};lines=[];?(bundle.source_header){lines.push(bundle.source_header)};lines.push('^schema_once');?(bundle.consts){keys=Object.keys(bundle.consts);?(keys.length>0){parts=[];#(i=0;i<keys.length;i++){parts.push(keys[i]+'='+bundle.consts[keys[i]])};lines.push('$K{'+parts.join(' ')+'}')}};#(m=0;m<bundle.modules.length;m++){mod=bundle.modules[m];rawParams='';#(p=0;p<mod.signature.params.length;p++){pp=mod.signature.params[p];?(p>0){rawParams=rawParams+','};?(pp.type&&pp.type!='any'){rawParams=rawParams+pp.name+': '+pp.type}else{rawParams=rawParams+pp.name}};retPart='';?(mod.signature.returns&&mod.signature.returns!='any'){retPart=' -> '+mod.signature.returns};lines.push('!'+mod.id+'('+rawParams+')'+retPart+'{/* '+mod.semantic_hash+' */}')};?(bundle.exports&&bundle.exports.length>0){lines.push('=ex{'+bundle.exports.join(',')+'}')};^lines.join('\n')}
!validateBundle(bundle){?(bundle==null){^({valid:false,reason:'null_bundle'})};?(bundle.format!=linbFormat()){^({valid:false,reason:'invalid_format:'+String(bundle.format)})};?(bundle.modules==null){^({valid:false,reason:'no_modules'})};^(true)}
!bundleStats(bundle){?(bundle==null||bundle.modules==null){^null};mods=bundle.modules;totalEffects=0;#(m=0;m<mods.length;m++){totalEffects=totalEffects+mods[m].effects.length};totalCalls=0;#(m=0;m<mods.length;m++){totalCalls=totalCalls+arrLen(mods[m].calls)};^({total_modules:mods.length,total_symbols:mods.length,total_effects:totalEffects,total_contracts:arrLen(bundle.contracts),total_calls:totalCalls,semantic_hash:bundle.semantic_hash,format:bundle.format,app:bundle.app})}
=ex{linbFormat,mkParam,mkContract,emptyContract,hasSub,extractEffects,isIdentStart,isIdentPart,isKeyword,extractCalls,extractPreFromParams,extractPostFromBody,dedup,arrLen,packLinb,unpackToLin,validateBundle,bundleStats}
