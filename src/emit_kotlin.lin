@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_kotlin
~G{?=if #=for ^=ret :else}

!kotlinType(id,inferred,orig){s=String(orig||id||'');?(/:num\b|:int\b/i.test(s)){^'Long'};?(/:bool\b/i.test(s)){^'Boolean'};?(/:string\b|:str\b/i.test(s)){^'String'};^String(inferred&&inferred.get(id)==='int'?'Long':inferred&&inferred.get(id)==='bool'?'Boolean':inferred&&inferred.get(id)==='string'?'String':'Any')}
!kotlinRetType(fn,stmts){inf=inferTypes(stmts);rets=[];walk=(list)=>{#(i=0;i<(list||[]).length;i++){st=list[i];?(st.type==='return'){e=String(st.expr||'').trim();?(e.charAt(0)==='('&&e.charAt(e.length-1)===')'){e=e.slice(1,-1)};rets.push(e)};?(st.then){walk(st.then)};?(st.else){walk(st.else)};?(st.body){walk(st.body)}}};walk(stmts);?(rets.length===0){^'Any'};?(rets.every((t)=>/^(true|false)$/.test(t)||/(==|!=|<=|>=|<|>)/.test(t))){^'Boolean'};?(rets.every((t)=>/^-?\d+$/.test(t)||isNumishId(t))){^'Long'};^'Any'}
!kotlinDefaultInit(type){?(type==='Long'){^'0L'};?(type==='Boolean'){^'false'};?(type==='String'){^'""'};^'Any()'}

!emitKIf(st,pad,indent){lines=[];lines.push(pad+'if ('+emitCond(st.cond,'kotlin')+') {');lines.push(...emitKStmts(st.then,indent+1));#(i=0;i<(st.elseIf||[]).length;i++){e=st.elseIf[i];lines.push(pad+'} else if ('+emitCond(e.cond,'kotlin')+') {');lines.push(...emitKStmts(e.body,indent+1))};?(st.else&&st.else.length>0){lines.push(pad+'} else {');lines.push(...emitKStmts(st.else,indent+1))};lines.push(pad+'}');^lines}
!emitKFor(st,pad,indent){lines=[];lines.push(pad+'for ('+rewriteExpr(st.init,'kotlin')+'; '+emitCond(st.cond,'kotlin')+'; '+rewriteExpr(st.step,'kotlin')+') {');lines.push(...emitKStmts(st.body,indent+1));lines.push(pad+'}');^lines}
!emitKWhile(st,pad,indent){lines=[];lines.push(pad+'while ('+emitCond(st.cond,'kotlin')+') {');lines.push(...emitKStmts(st.body,indent+1));lines.push(pad+'}');^lines}
!emitKSimple(st,pad){lines=[];?(st.type==='assign'){lines.push(pad+rewriteExpr(st.id,'kotlin')+' '+st.op+' '+rewriteExpr(st.expr,'kotlin'))};?(st.type==='return'){lines.push(pad+'return '+rewriteExpr(st.expr,'kotlin'))};?(st.type==='throw'){lines.push(pad+'throw RuntimeException('+rewriteExpr(st.expr,'kotlin')+')')};?(st.type==='expr'){lines.push(pad+rewriteExpr(st.expr,'kotlin'))};^lines}

!emitKStmts(stmts,indent){pad='    '.repeat(indent);lines=[];#(i=0;i<(stmts||[]).length;i++){st=stmts[i];?(st.type==='if'){lines.push(...emitKIf(st,pad,indent))};?(st.type==='for'){lines.push(...emitKFor(st,pad,indent))};?(st.type==='while'){lines.push(...emitKWhile(st,pad,indent))};?(st.type!=='if'&&st.type!=='for'&&st.type!=='while'){lines.push(...emitKSimple(st,pad))}};^lines}

!emitKFn(fn){params=fn.params.split(',').map((p)=>p.trim());stmts=tryParseStmts(fn.body);?(stmts){emitted=emitKStmts(stmts,1);ret=kotlinRetType(fn,stmts);return 'fun '+fn.name+'('+params.join(', ')+'): '+ret+' {\n'+emitted.join('\n')+'\n}'};^'fun '+fn.name+'(): Boolean { throw RuntimeException("not implemented") }'}
!emitK(liaText){prog=parseLia(liaText);parts=['// generated by lia multi-emit → kotlin',''];#(i=0;i<prog.fns.length;i++){parts.push(emitKFn(prog.fns[i]))};^(JSON.stringify({code:parts.join('\n')+'\n',target:'kotlin'}))}

=ex{kotlinType,kotlinRetType,kotlinDefaultInit,emitKIf,emitKFor,emitKWhile,emitKSimple,emitKStmts,emitKFn,emitK}
