@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_cpp
~G{?=if #=for ^=ret :else}

!cppRawType(tag){s=String(tag);rl=String.fromCharCode(58,58);?(s==='s'){^'std'+rl+'string'};?(s==='n'){^'long long'};?(s==='b'){^'bool'};^'auto'}
!cppType(id,inferred,orig){s=String(orig||id||'');?(/:num\b|:int\b/i.test(s)){^cppRawType('n')};?(/:bool\b/i.test(s)){^cppRawType('b')};?(/:string\b|:str\b/i.test(s)){^cppRawType('s')};^String(inferred&&inferred.get(id)==='int'?cppRawType('n'):inferred&&inferred.get(id)==='bool'?cppRawType('b'):inferred&&inferred.get(id)==='string'?cppRawType('s'):cppRawType('a'))}
!cppRetType(fn,stmts){inf=inferTypes(stmts);rets=[];walk=(list)=>{#(i=0;i<(list||[]).length;i++){st=list[i];?(st.type==='return'){rets.push(String(st.expr||'').trim())};?(st.then){walk(st.then)};?(st.else){walk(st.else)};?(st.body){walk(st.body)}}};walk(stmts);?(rets.length===0){^cppRawType('a')};allBool=true;allNum=true;allStr=true;#(i=0;i<rets.length;i++){t=rets[i];?(t!=='true'&&t!=='false'&&(t.indexOf('==')<0&&t.indexOf('!=')<0&&t.indexOf('<')<0&&t.indexOf('>')<0)){allBool=false};?(!isNumishId(t)&&!/^-?\d+$/.test(t)){allNum=false};?(t.indexOf(String.fromCharCode(34))!==0&&t.indexOf("'")!==0&&!isStringishId(t)){allStr=false}};?(allBool){^cppRawType('b')};?(allNum){^cppRawType('n')};?(allStr){^cppRawType('s')};^cppRawType('a')}
!cppThrow(e){rl=String.fromCharCode(58,58);^'throw std'+rl+'runtime_error('+rewriteExpr(e,'cpp')+');'}
!cppDefaultInit(t){rl=String.fromCharCode(58,58);nt=cppRawType('n');bt=cppRawType('b');st=cppRawType('s');?(t===nt){^'0LL'};?(t===bt){^'false'};?(t===st){^st+'()'};^'auto()'}

!emitCIf(st,pad,indent){lines=[];lines.push(pad+'if ('+emitCond(st.cond,'cpp')+') {');lines.push(...emitCStmts(st.then,indent+1));#(i=0;i<(st.elseIf||[]).length;i++){e=st.elseIf[i];lines.push(pad+'} else if ('+emitCond(e.cond,'cpp')+') {');lines.push(...emitCStmts(e.body,indent+1))};?(st.else){lines.push(pad+'} else {');lines.push(...emitCStmts(st.else,indent+1))};lines.push(pad+'}');^lines}
!emitCFor(st,pad,indent){lines=[];lines.push(pad+'for ('+rewriteExpr(st.init,'cpp')+'; '+emitCond(st.cond,'cpp')+'; '+rewriteExpr(st.step,'cpp')+') {');lines.push(...emitCStmts(st.body,indent+1));lines.push(pad+'}');^lines}
!emitCWhile(st,pad,indent){lines=[];lines.push(pad+'while ('+emitCond(st.cond,'cpp')+') {');lines.push(...emitCStmts(st.body,indent+1));lines.push(pad+'}');^lines}
!emitCSimple(st,pad){lines=[];?(st.type==='assign'){lines.push(pad+'auto '+rewriteExpr(st.id,'cpp')+' = '+rewriteExpr(st.expr,'cpp')+';')};?(st.type==='return'){lines.push(pad+'return '+rewriteExpr(st.expr,'cpp')+';')};?(st.type==='throw'){lines.push(pad+cppThrow(st.expr))};?(st.type==='expr'){lines.push(pad+rewriteExpr(st.expr,'cpp')+';')};^lines}

!emitCStmts(stmts,indent){pad='    '.repeat(indent);lines=[];#(i=0;i<(stmts||[]).length;i++){st=stmts[i];?(st.type==='if'){lines.push(...emitCIf(st,pad,indent))};?(st.type==='for'){lines.push(...emitCFor(st,pad,indent))};?(st.type==='while'){lines.push(...emitCWhile(st,pad,indent))};?(st.type!=='if'&&st.type!=='for'&&st.type!=='while'){lines.push(...emitCSimple(st,pad))}};^lines}

!emitCFn(fn){params=fn.params.split(',').map((p)=>p.trim());stmts=tryParseStmts(fn.body);?(stmts){emitted=emitCStmts(stmts,1);ret=cppRetType(fn,stmts);return ret+' '+fn.name+'('+params.join(', ')+') {\n'+emitted.join('\n')+'\n}'};rl=String.fromCharCode(58,58);^'bool '+fn.name+'() { throw std'+rl+'runtime_error("not implemented"); }'}
!emitCpp(liaText){prog=parseLia(liaText);parts=['// generated by lia multi-emit → cpp','#include <string>','#include <stdexcept>','#include <cmath>','#include <cstdlib>','#include <cstring>','#include <vector>',''];#(i=0;i<prog.fns.length;i++){parts.push(emitCFn(prog.fns[i]))};^(JSON.stringify({code:parts.join('\n')+'\n',target:'cpp'}))}

=ex{cppRawType,cppType,cppRetType,cppThrow,cppDefaultInit,emitCIf,emitCFor,emitCWhile,emitCSimple,emitCStmts,emitCFn,emitCpp}
