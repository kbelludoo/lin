@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_julia
~G{?=if #=for ^=ret :else}

!juliaRetType(fn,stmts){rets=[];walk=(list)=>{#(i=0;i<(list||[]).length;i++){st=list[i];?(st.type==='return'){e=String(st.expr||'').trim();?(e.charAt(0)==='('&&e.charAt(e.length-1)===')'){e=e.slice(1,-1)};rets.push(e)};?(st.then){walk(st.then)};?(st.else){walk(st.else)};?(st.body){walk(st.body)}}};walk(stmts);?(rets.length===0){^'Nothing'};?(rets.every((t)=>/^(true|false)$/.test(t)||/(==|!=|<=|>=|<|>)/.test(t))){^'Bool'};?(rets.every((t)=>/^-?\d+$/.test(t)||isNumishId(t))){^'Int64'};?(rets.every((t)=>isStringishId(t)||/_lia_cat/.test(t))){^'String'};^'Any'}

!juliaParamType(raw){name=raw.split(':')[0].trim();?(isNumishId(name)){^'Int64'};?(isBoolishId(name)){^'Bool'};?(isStringishId(name)){^'String'};^'Any'}

!emitJAssign(st,pad){lines=[];lines.push(pad+rewriteExpr(st.id,'julia')+' '+st.op+' '+rewriteExpr(st.expr,'julia'));^lines}
!emitJReturn(st,pad){lines=[];lines.push(pad+'return '+rewriteExpr(st.expr,'julia'));^lines}
!emitJThrow(st,pad){lines=[];lines.push(pad+'error('+rewriteExpr(st.expr,'julia')+')');^lines}
!emitJExpr(st,pad){lines=[];lines.push(pad+rewriteExpr(st.expr,'julia'));^lines}

!emitJIf(st,pad,indent){lines=[];lines.push(pad+'if '+emitCond(st.cond,'julia'));lines.push(...emitJStmts(st.then,indent+1));#(i=0;i<(st.elseIf||[]).length;i++){e=st.elseIf[i];lines.push(pad+'elseif '+emitCond(e.cond,'julia'));lines.push(...emitJStmts(e.body,indent+1))};?(st.else&&st.else.length>0){lines.push(pad+'else');lines.push(...emitJStmts(st.else,indent+1))};lines.push(pad+'end');^lines}

!emitJFor(st,pad,indent){lines=[];ip=String(st.init||'').split('=');vn=ip[0]||'i';sv=ip[1]||'0';cp=String(st.cond||'').split(/[<>=!]+/);ev=cp[1]||'0';lines.push(pad+'for '+vn+' in '+rewriteExpr(sv,'julia')+':'+rewriteExpr(ev,'julia'));lines.push(...emitJStmts(st.body,indent+1));lines.push(pad+'end');^lines}

!emitJWhile(st,pad,indent){lines=[];?(String(st.cond).trim()==='true'){lines.push(pad+'while true');lines.push(...emitJStmts(st.body,indent+1));lines.push(pad+'end');return lines};lines.push(pad+'while '+emitCond(st.cond,'julia'));lines.push(...emitJStmts(st.body,indent+1));lines.push(pad+'end');^lines}

!emitJStmts(stmts,indent){pad='  '.repeat(indent);lines=[];#(i=0;i<(stmts||[]).length;i++){st=stmts[i];?(st.type==='assign'){lines.push(...emitJAssign(st,pad))};?(st.type==='return'){lines.push(...emitJReturn(st,pad))};?(st.type==='throw'){lines.push(...emitJThrow(st,pad))};?(st.type==='if'){lines.push(...emitJIf(st,pad,indent))};?(st.type==='for'){lines.push(...emitJFor(st,pad,indent))};?(st.type==='while'){lines.push(...emitJWhile(st,pad,indent))};?(st.type==='expr'){lines.push(...emitJExpr(st,pad))}};^lines}

!emitJFn(fn){names=emitNameMap([fn]);juliaName=names[fn.name];params=fn.params.split(',').map((p)=>p.trim());pl=params.map((p)=>safeEmitId(p)).join(', ');stmts=tryParseStmts(fn.body);?(stmts){emitted=emitJStmts(stmts,1);ret=juliaRetType(fn,stmts);?(ret==='Bool'){emitted.push('  return false')};?(ret==='Int64'){emitted.push('  return 0')};?(ret==='String'){emitted.push('  return ""')};return 'function '+juliaName+'('+pl+')\n'+emitted.join('\n')+'\nend'};return 'function '+juliaName+'('+pl+')\n  error("LIA_EMIT_JULIA: JS-runtime-only")\nend'}

!emitJulia(liaText){prog=parseLia(liaText);parts=['# generated by lia multi-emit → julia',''];#(i=0;i<prog.fns.length;i++){parts.push(emitJFn(prog.fns[i]))};H='\n# Julia runtime helpers\n_lia_obj()=Dict{String,Any}()\n_lia_cat(a,b)=string(a)*string(b)\n_lia_str(x)=string(x===nothing ? "" : x)\n_lia_num(x)=isa(x,Number) ? (isa(x,AbstractFloat) ? round(Int64,x) : Int64(x)) : Int64(0)\n_lia_abs(x)=abs(_lia_num(x))\n_lia_round(x)=_lia_num(x)\n_lia_len(x)=isa(x,AbstractString) ? length(x) : isa(x,AbstractArray) ? length(x) : 0\n_lia_typeof(x)=isa(x,Bool) ? "boolean" : isa(x,Number) ? "number" : isa(x,AbstractString) ? "string" : "object"\n_lia_falsy(x)=x===nothing || x===false || x===0 || x===""\n_lia_or(a,b)=_lia_falsy(a) ? b : a\n_lia_isnan(x)=isa(x,Number) && isnan(x)\n_lia_isfinite(x)=isa(x,Number) && isfinite(x)\n_lia_at(s,i)=(i<1 || i>length(string(s))) ? "" : string(s)[i]\n_lia_code_at(s,i)=(i<1 || i>length(string(s))) ? 0 : Int(codepoint(string(s)[i]))\n_lia_includes(s,sub)=occursin(string(sub),string(s))\n_lia_lower(x)=lowercase(string(x))\n_lia_instanceof(x,y)=false\n_lia_set(obj,key,val)=val\n_lia_get(obj,key)=nothing\n';parts.push(H);^(JSON.stringify({code:parts.join('\n')+'\n',target:'julia'}))}

=ex{juliaRetType,juliaParamType,emitJAssign,emitJReturn,emitJThrow,emitJExpr,emitJIf,emitJFor,emitJWhile,emitJStmts,emitJFn,emitJulia}
