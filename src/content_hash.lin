@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=content_hash
~G{?=if #=for ^=ret :else}
!canonicalize(fnName,params,body){canon=String(body||'').trim();canon=canon.replace(/\s+/g,' ');paramList=String(params||'').split(',');clean=[];#(i=0;i<paramList.length;i++){p=paramList[i].trim().replace(/:.+$/,'');?(p){clean.push(p)}};#(j=0;j<clean.length;j++){re_=new RegExp('\\b'+clean[j]+'\\b','g');canon=canon.replace(re_,'$'+j)};canon=canon.replace(/'/g,'"');canon=canon.replace(/===/g,'==').replace(/!==/g,'!=');canon=canon.replace(/;\s*/g,';');^('('+clean.length+')'+canon)}
!contentHash(fnName,params,body){canonical=canonicalize(fnName,params,body);hash=require('node:crypto').createHash('sha256').update(canonical,'utf8').digest('hex');^hash.slice(0,16)}
!semanticEquals(fn1,fn2){h1=contentHash(fn1.name,fn1.params,fn1.body);h2=contentHash(fn2.name,fn2.params,fn2.body);^(h1==h2)}
!buildContentRegistry(prog){registry={};fns=prog.fns||[];#(i=0;i<fns.length;i++){fn=fns[i];hash=contentHash(fn.name,fn.params,fn.body);registry[hash]={name:fn.name,params:fn.params,hash:hash,bodyLen:(fn.body||'').length}};^registry}
=ex{canonicalize,contentHash,semanticEquals,buildContentRegistry}
