@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=lin_workflow_engine
~G{?=if #=for ^=ret :else}

!verifyWorkflowEdges(nodes,edges){errors=[];#(i=0;i<edges.length;i++){e=edges[i];source=nodes[e.from_node];target=nodes[e.to_node];?(source==null){errors.push('source_node_missing:'+e.from_node)};?(target==null){errors.push('target_node_missing:'+e.to_node)}};^({valid:errors.length==0,errors:errors})}

!collectWorkflowEffects(nodes){allEffs=[];keys=Object.keys(nodes||{});#(i=0;i<keys.length;i++){n=nodes[keys[i]];effs=n.effects||[];#(j=0;j<effs.length;j++){allEffs.push(effs[j])}};^allEffs}

!computeWorkflowMetadata(dagId,entryNode,nodeCount,edgeCount){^({workflow_id:dagId,entry:entryNode,total_nodes:nodeCount,total_edges:edgeCount,verified_at:Date.now()})}

=ex{verifyWorkflowEdges,collectWorkflowEffects,computeWorkflowMetadata}
