@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_swift
~G{?=if #=for ^=ret :else}

!swiftType(id,inferred,orig){s=String(orig||id||'');?(/:num\b|:int\b/i.test(s)){^'Int'};?(/:bool\b/i.test(s)){^'Bool'};?(/:string\b|:str\b/i.test(s)){^'String'};^String(inferred&&inferred.get(id)==='int'?'Int':inferred&&inferred.get(id)==='bool'?'Bool':inferred&&inferred.get(id)==='string'?'String':'Any')}
!swiftRetType(fn,stmts){inf=inferTypes(stmts);rets=[];walk=(list)=>{#(i=0;i<(list||[]).length;i++){st=list[i];?(st.type==='return'){e=String(st.expr||'').trim();?(e.charAt(0)==='('&&e.charAt(e.length-1)===')'){e=e.slice(1,-1)};rets.push(e)};?(st.then){walk(st.then)};?(st.else){walk(st.else)};?(st.body){walk(st.body)}}};walk(stmts);?(rets.length===0){^'Any'};?(rets.every((t)=>/^(true|false)$/.test(t)||/(==|!=|<=|>=|<|>)/.test(t))){^'Bool'};?(rets.every((t)=>/^-?\d+$/.test(t)||isNumishId(t))){^'Int'};^'Any'}
!swiftDefaultInit(type){?(type==='Int'){^'0'};?(type==='Bool'){^'false'};?(type==='String'){^'""'};^'Any()'}

!emitSIf(st,pad,indent){lines=[];lines.push(pad+'if '+emitCond(st.cond,'swift')+' {');lines.push(...emitSStmts(st.then,indent+1));#(i=0;i<(st.elseIf||[]).length;i++){e=st.elseIf[i];lines.push(pad+'} else if '+emitCond(e.cond,'swift')+' {');lines.push(...emitSStmts(e.body,indent+1))};?(st.else&&st.else.length>0){lines.push(pad+'} else {');lines.push(...emitSStmts(st.else,indent+1))};lines.push(pad+'}');^lines}
!emitSFor(st,pad,indent){lines=[];lines.push(pad+'for '+rewriteExpr(st.init,'swift')+'; '+emitCond(st.cond,'swift')+'; '+rewriteExpr(st.step,'swift')+' {');lines.push(...emitSStmts(st.body,indent+1));lines.push(pad+'}');^lines}
!emitSWhile(st,pad,indent){lines=[];lines.push(pad+'while '+emitCond(st.cond,'swift')+' {');lines.push(...emitSStmts(st.body,indent+1));lines.push(pad+'}');^lines}
!emitSSimple(st,pad){lines=[];?(st.type==='assign'){lines.push(pad+'var '+rewriteExpr(st.id,'swift')+' '+st.op+' '+rewriteExpr(st.expr,'swift'))};?(st.type==='return'){lines.push(pad+'return '+rewriteExpr(st.expr,'swift'))};?(st.type==='throw'){lines.push(pad+'fatalError('+rewriteExpr(st.expr,'swift')+')')};?(st.type==='expr'){lines.push(pad+rewriteExpr(st.expr,'swift'))};^lines}

!emitSStmts(stmts,indent){pad='    '.repeat(indent);lines=[];#(i=0;i<(stmts||[]).length;i++){st=stmts[i];?(st.type==='if'){lines.push(...emitSIf(st,pad,indent))};?(st.type==='for'){lines.push(...emitSFor(st,pad,indent))};?(st.type==='while'){lines.push(...emitSWhile(st,pad,indent))};?(st.type!=='if'&&st.type!=='for'&&st.type!=='while'){lines.push(...emitSSimple(st,pad))}};^lines}

!emitSFn(fn){params=fn.params.split(',').map((p)=>p.trim());stmts=tryParseStmts(fn.body);?(stmts){emitted=emitSStmts(stmts,1);ret=swiftRetType(fn,stmts);return 'func '+fn.name+'('+params.join(', ')+') -> '+ret+' {\n'+emitted.join('\n')+'\n}'};^'func '+fn.name+'() -> Bool { fatalError("not implemented") }'}
!emitS(liaText){prog=parseLia(liaText);parts=['// generated by lia multi-emit → swift',''];#(i=0;i<prog.fns.length;i++){parts.push(emitSFn(prog.fns[i]))};^(JSON.stringify({code:parts.join('\n')+'\n',target:'swift'}))}

=ex{swiftType,swiftRetType,swiftDefaultInit,emitSIf,emitSFor,emitSWhile,emitSSimple,emitSStmts,emitSFn,emitS}
