@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_elixir
~G{?=if #=for ^=ret :else}

!elixirRetType(fn,stmts){rets=[];walk=(list)=>{#(i=0;i<(list||[]).length;i++){st=list[i];?(st.type==='return'){e=String(st.expr||'').trim();?(e.charAt(0)==='('&&e.charAt(e.length-1)===')'){e=e.slice(1,-1)};rets.push(e)};?(st.then){walk(st.then)};?(st.else){walk(st.else)};?(st.body){walk(st.body)}}};walk(stmts);?(rets.length===0){^'nil'};?(rets.every((t)=>/^(true|false)$/.test(t)||/(==|!=|<=|>=|<|>)/.test(t))){^'boolean()'};?(rets.every((t)=>/^-?\d+$/.test(t)||isNumishId(t))){^'integer()'};?(rets.every((t)=>isStringishId(t)||/_lia_cat/.test(t))){^'String.t()'};^'any()'}

!elixirParamType(raw){name=raw.split(':')[0].trim();?(isNumishId(name)){^'integer()'};?(isBoolishId(name)){^'boolean()'};?(isStringishId(name)){^'String.t()'};^'any()'}

!emitEAssign(st,pad){lines=[];lines.push(pad+rewriteExpr(st.id,'elixir')+' = '+rewriteExpr(st.expr,'elixir'));^lines}
!emitEReturn(st,pad){lines=[];lines.push(pad+rewriteExpr(st.expr,'elixir'));^lines}
!emitEThrow(st,pad){lines=[];lines.push(pad+'raise '+rewriteExpr(st.expr,'elixir'));^lines}
!emitEExpr(st,pad){lines=[];lines.push(pad+rewriteExpr(st.expr,'elixir'));^lines}

!emitEIf(st,pad,indent){lines=[];lines.push(pad+'if '+emitCond(st.cond,'elixir')+' do');lines.push(...emitEStmts(st.then,indent+1));?(st.else&&st.else.length>0){lines.push(pad+'else');lines.push(...emitEStmts(st.else,indent+1))};lines.push(pad+'end');^lines}

!emitEFor(st,pad,indent){lines=[];ip=String(st.init||'').split('=');vn=ip[0]||'i';sv=ip[1]||'0';cp=String(st.cond||'').split(/[<>=!]+/);ev=cp[1]||'0';lines.push(pad+'for '+vn+' <- '+rewriteExpr(sv,'elixir')+'..'+rewriteExpr(ev,'elixir')+' do');lines.push(...emitEStmts(st.body,indent+1));lines.push(pad+'end');^lines}

!emitEWhile(st,pad,indent){lines=[];?(String(st.cond).trim()==='true'){lines.push(pad+'# infinite loop');lines.push(...emitEStmts(st.body,indent+1));return lines};lines.push(pad+'if '+emitCond(st.cond,'elixir')+' do');lines.push(...emitEStmts(st.body,indent+1));lines.push(pad+'end');^lines}

!emitEStmts(stmts,indent){pad='  '.repeat(indent);lines=[];#(i=0;i<(stmts||[]).length;i++){st=stmts[i];?(st.type==='assign'){lines.push(...emitEAssign(st,pad))};?(st.type==='return'){lines.push(...emitEReturn(st,pad))};?(st.type==='throw'){lines.push(...emitEThrow(st,pad))};?(st.type==='if'){lines.push(...emitEIf(st,pad,indent))};?(st.type==='for'){lines.push(...emitEFor(st,pad,indent))};?(st.type==='while'){lines.push(...emitEWhile(st,pad,indent))};?(st.type==='expr'){lines.push(...emitEExpr(st,pad))}};^lines}

!emitEFn(fn){names=emitNameMap([fn]);elixirName=names[fn.name];params=fn.params.split(',').map((p)=>p.trim());pl=params.map((p)=>safeEmitId(p)).join(', ');stmts=tryParseStmts(fn.body);?(stmts){emitted=emitEStmts(stmts,1);ret=elixirRetType(fn,stmts);?(ret==='boolean()'){emitted.push('    false')};?(ret==='integer()'){emitted.push('    0')};?(ret==='String.t()'){emitted.push('    ""')};return '  def '+elixirName+'('+pl+') do\n'+emitted.join('\n')+'\n  end'};return '  def '+elixirName+'('+pl+'), do: raise("LIA_EMIT_ELIXIR: JS-runtime-only")'}

!emitElixir(liaText){prog=parseLia(liaText);parts=['# generated by lia multi-emit → elixir','defmodule LiaGenerated do'];#(i=0;i<prog.fns.length;i++){parts.push(emitEFn(prog.fns[i]))};H='\n  # Elixir runtime helpers\n  defp _lia_cat(a,b),do: to_string(a)<>to_string(b)\n  defp _lia_str(x),do: to_string(x||"")\n  defp _lia_num(x),do: (x||0)|>then(fn x when is_integer(x)->x; x when is_float(x)->round(x); _->0 end)\n  defp _lia_abs(x),do: abs(_lia_num(x))\n  defp _lia_round(x),do: _lia_num(x)\n  defp _lia_len(x) when is_binary(x),do: byte_size(x)\n  defp _lia_len(x) when is_list(x),do: length(x)\n  defp _lia_len(_),do: 0\n  defp _lia_typeof(x) when is_boolean(x),do: "boolean"\n  defp _lia_typeof(x) when is_integer(x) or is_float(x),do: "number"\n  defp _lia_typeof(x) when is_binary(x),do: "string"\n  defp _lia_typeof(_),do: "object"\n  defp _lia_falsy(nil),do: true\n  defp _lia_falsy(false),do: true\n  defp _lia_falsy(0),do: true\n  defp _lia_falsy(""),do: true\n  defp _lia_falsy(_),do: false\n  defp _lia_or(a,b),do: if(_lia_falsy(a),do: b,else: a)\n  defp _lia_isnan(x),do: x!=x\n  defp _lia_isfinite(_),do: true\n  defp _lia_at(s,i) do; s=to_string(s||""); i=_lia_num(i); if i<1 or i>byte_size(s),do: "",else: binary_part(s,i-1,1); end\n  defp _lia_code_at(s,i) do; s=to_string(s||""); i=_lia_num(i); if i<1 or i>byte_size(s),do: 0,else: :binary.at(s,i-1); end\n  defp _lia_includes(s,sub),do: String.contains?(to_string(s),to_string(sub))\n  defp _lia_lower(x),do: String.downcase(to_string(x||""))\n  defp _lia_instanceof(_,_),do: false\n  defp _lia_set(obj,key,val),do: val\n  defp _lia_get(obj,key),do: nil\n  defp _lia_obj,do: %{}\n';parts.push(H);parts.push('end');^(JSON.stringify({code:parts.join('\n')+'\n',target:'elixir'}))}

=ex{elixirRetType,elixirParamType,emitEAssign,emitEReturn,emitEThrow,emitEExpr,emitEIf,emitEFor,emitEWhile,emitEStmts,emitEFn,emitElixir}
