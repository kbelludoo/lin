@RULEL:LIN_INDEX:1.5.0
~R{.m=meta .c=commands .p=path .g=gate .a=allow .f=forbid}
.m{
  name=lin-lang
  path="C:/Users/k/Documents/lia"
  role=canonical_LIN_repo
  formerly=lia|ail
  compile=LIN_multi_emit_and_native_workflow
  dicel=legacy_archive_only
  ainl_external=retired_dependency_independent_baseline_only
}
.c{
  test="npm test"
  test_multi="npm run test:multi"
  emit="node bin/lin.mjs emit"
  compile="node bin/lin.mjs compile <lin> --target js|ts|py|go|rust"
  workflow="node -e 'import(\"./src/lin_workflow_engine.mjs\")'"
}
.g{clone=full_repo_100_hash_eq workflow_gate=hierarchical_hash_invariant LIA_gate=ge_Dicel}
.a{code=.lin|.lia rules=.rulel|.md(RULEL)}
.f{hand_TS hand_JS external_runtime_dependency mutate_lin_nucleus}
.p{
  workflow_engine=src/lin_workflow_engine.mjs
  workflow_spec=spec/LIN_WORKFLOW_IR_SPEC_FREEZE.md
  evidence_matrix=spec/EVIDENCE_MATRIX_CONSOLIDATED.md
  research_claims=spec/RESEARCH_CLAIMS.md
  reproduction=spec/REPRODUCTION.md
  threats=spec/THREATS_TO_VALIDITY.md
}
