    type: "architectural_rule"
  }

  @K017 {
    honesty: OBSERVED
    fact: "Crystal discovered via environment scan; binary exists as ELF (Linux), recompiled for Windows"
    source: "END_TO_END_CRYSTAL_01"
    type: "discovery_record"
  }

  @K018 {
    honesty: OBSERVED
    fact: "Crystal semantic hash algorithm differs from MJS; semantic_equivalence = false; performance comparison is diagnostic only, not valid ranking"
    source: "END_TO_END_CRYSTAL_01"
    type: "methodological_rule"
    provenance: {
      module: "content_hash"
      workload_hash: "sha256:content_hash_10fns"
      environment: "Node.js v24.19.0 / Crystal 1.21.0 / Windows x64"
      benchmark_run: "2026-08-16"
      semantic_hash_crystal: "86b480eb51280f0a"
      semantic_hash_mjs: "313817cb68d86490"
      semantic_equivalence: false
      performance_crystal_us: 49039.74
      performance_typescript_us: 5.51
      interpretation: "semantic_fail_blocks_valid_ranking; performance is diagnostic_only"
      confidence: "single_module_single_workload"
    }
  }

  @K019 {
    honesty: OBSERVED
    fact: "Crystal REJECTED for string_heavy + regex_heavy: semantic mismatch blocks valid ranking; 8,900x slower is diagnostic only"
    source: "END_TO_END_CRYSTAL_01"
    type: "conditional_rule"
  }

  @K020 {
    honesty: OBSERVED
    fact: "semantic_equivalence = FAIL enters semantic_repair_loop; if repaired → benchmark valid; if budget exhausted → diagnostic only"
    source: "SEMANTIC_REPAIR_LOOP"
    type: "methodological_rule"
  }

  @K021 {
    honesty: OBSERVED
    fact: "LANGUAGE_DISCOVERY can find languages not in knowledge base, profile them, and produce evidence"
    source: "END_TO_END_CRYSTAL_01"
    type: "architectural_rule"
  }

  @K022 {
    honesty: OBSERVED
    fact: "Semantic repair loop: mismatch → diagnose → classify → repair → verify; oracle immutable, candidate mutable"
    source: "SEMANTIC_REPAIR_LOOP"
    type: "architectural_rule"
  }

  @K023 {
    honesty: OBSERVED
    fact: "Repair budget: max 3 iterations, max 60s time; terminate with REJECTED_AFTER_BUDGET if exceeded"
    source: "SEMANTIC_REPAIR_LOOP"
    type: "methodological_rule"
  }

  @K024 {
    honesty: OBSERVED
    fact: "Repair chain is fully auditable: each iteration records candidate_hash_before, repair_applied, candidate_hash_after, semantic_hash_after, repair_diff_hash"
    source: "SEMANTIC_REPAIR_LOOP v1.1"
    type: "architectural_rule"
  }

  @K025 {
    honesty: OBSERVED
    fact: "Repair chain includes environment_hash and oracle_version_hash for cross-environment reproducibility"
    source: "SEMANTIC_REPAIR_LOOP v1.1"
    type: "architectural_rule"
  }

  @K026 {
    honesty: OBSERVED
    fact: "Repair iterations form a verifiable chain via parent_iteration_hash linking"
    source: "SEMANTIC_REPAIR_LOOP v1.1"
    type: "architectural_rule"
  }

  @K027 {
    honesty: OBSERVED
    fact: "Mismatch taxonomy enables learning repair strategies by error class: whitespace→normalize, ordering→sort, regex→dialect compatibility"
    source: "SEMANTIC_REPAIR_LOOP v1.1"
    type: "knowledge_rule"
  }
}
}

