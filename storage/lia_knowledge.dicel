@DICEL:lia_knowledge:0.4.0
^status=ACTIVE
^honesty=[OBSERVED,INFERRED,UNKNOWN]

@ENTRIES {
  @K001 {
    honesty: OBSERVED
    fact: "TS/src 453359 LOC holdout exact 183/500 (36.6%); lodash isolated 246/400 (61.5%)"
    source: "INTEL_AIL_SIZE_DISK_BENCHMARK.dicel"
  }
  @K002 {
    honesty: OBSERVED
