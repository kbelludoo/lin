  }

  @K014 {
    honesty: OBSERVED
    fact: "Rust is a Tier-1 candidate, not a proven winner; backend selection must be empirical"
    source: "KERNEL_CANDIDATE_V1"
    type: "architectural_rule"
  }

  @K015 {
    honesty: OBSERVED
    fact: "Language Discovery is a prerequisite for Kernel Candidate; environment scan before assumption"
