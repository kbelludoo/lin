  }
  @K004 {
    honesty: OBSERVED
    fact: "clone-lia dayjs utils: absFloor+isUndefined exact-hash PASS after arrow+ASI emitter fixes; 4/6 skipped (templates/closures)"
    source: "INTEL_CLONE_LIA_dayjs.dicel"
  }
  @K005 {
    honesty: OBSERVED
    fact: "Math.* must not classify as host_or_module_ref; only non-builtin Capitals (e.g. C.M)"
    source: "clone_lia_oracle unsupported()"
  }

  @K006 {
    honesty: OBSERVED
    fact: "Language fitness is contextual: MJS STRONG for string-heavy+regex-heavy workloads; Rust REJECTED for same"
    source: "SELF-OPTIMIZE-01"
    provenance: {
      module: "content_hash"
      workload_hash: "sha256:content_hash_10fns"
      environment: "Node.js v24.19.0 / Windows x64"
      benchmark_run: "2026-08-16"
      semantic_hash_mjs: "313817cb68d86490"
      semantic_hash_rust: "2c22aa13d84f2fc5"
      semantic_equivalence: false
      performance_mjs_us: 8.26
      performance_rust_us: 110.89
      confidence: "single_module_single_workload"
    }
  }

  @K007 {
    honesty: OBSERVED
    fact: "Rust regex compilation overhead dominates string-heavy workloads; naive porting can be 13-48x slower than V8"
    source: "SELF-OPTIMIZE-02"
    provenance: {
      module: "content_hash"
      workload_type: "string_heavy + regex_heavy"
      v1_naive_rust_us: 252.79
      v2_optimized_rust_us: 110.89
      mjs_baseline_us: 8.26
      optimization_gain: "2.26x (v1→v2) but still 13x slower than MJS"
    }
  }

  @K008 {
    honesty: OBSERVED
    fact: "WHEN workload: string_heavy AND regex_heavy THEN prefer candidates with strong text-processing evidence"
    source: "SELF-OPTIMIZE-01+02 inductive"
    type: "conditional_rule"
  }

  @K009 {
    honesty: OBSERVED
    fact: "Semantic equivalence must be verified BEFORE measuring performance; hash mismatch = immediate reject"
    source: "SELF-OPTIMIZE-01"
    type: "methodological_rule"
  }

  @K010 {
    honesty: OBSERVED
    fact: "Python achieves semantic equivalence with MJS for content_hash; 1.3-3.8x slower but acceptable"
    source: "SELF-OPTIMIZE-03"
    provenance: {
      module: "content_hash"
      workload_type: "string_heavy + regex_heavy"
      mjs_baseline_us: 8.26
      python_us: 10.96
      semantic_match: true
      confidence: "single_module_single_workload"
    }
  }

  @K011 {
    honesty: OBSERVED
    fact: "Performance ranking for string-heavy+regex-heavy: MJS > Python > Rust"
    source: "SELF_OPTIMIZE-03"
    type: "conditional_rule"
  }

  @K012 {
    honesty: OBSERVED
    fact: "TypeScript variant faster than MJS under Node.js v24 for string-heavy workload"
    source: "SELF_OPTIMIZE-04"
    provenance: {
      module: "content_hash"
      workload_type: "string_heavy + regex_heavy"
      typescript_us: 5.51
      mjs_baseline_us: 8.26
      speedup: "1.5x"
