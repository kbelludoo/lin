@EXPERIMENT_SCHEDULE {
  description: "Ordered list of experiments to reduce knowledge gaps"
  
  @EXP001 {
    id: "DISCOVERY-01",
    language: "Lua",
    type: "LANGUAGE_DISCOVERY",
    status: "PLANNED",
    trigger: "knowledge_gap GAP001",
    expected_outcome: "language_profile + fitness for string_heavy workload",
    depends_on: []
  }
  
  @EXP002 {
    id: "SELF_OPTIMIZE-03",
    type: "PARALLEL_CANDIDATE",
    status: "COMPLETED",
    trigger: "after DISCOVERY-01 completes",
    module: "content_hash",
    candidates: ["MJS", "Nim", "Lua"],
    expected_outcome: "evidence-based comparison with baseline included"
  }
  
  @EXP003 {
    id: "TRANSFER_TEST_01",
    type: "KNOWLEDGE_TRANSFER",
    status: "PLANNED",
    trigger: "after SELF_OPTIMIZE-04 completes",
    description: "Test if LIN can use prior knowledge to select candidates for new module",
    new_module: "lin_effects (string_heavy + regex_heavy workload)",
    prior_knowledge: "TypeScript > MJS > Python > Rust for string_heavy + regex_heavy",
    expected_outcome: "LIN selects TypeScript as first candidate without re-discovery"
  }
}

@KNOWLEDGE_TRANSFER {
  description: "Mechanism for using prior experimental knowledge in new decisions"
  
  @TRANSFER_RULE_001 {
    condition: "new_module has similar workload_type to previously tested module"
    action: "retrieve prior ranking from @LANGUAGE_FITNESS"
    selection: "top_ranked_language_with_STRONG_fitness as first candidate"
    confidence: "proportional to number of prior experiments supporting ranking"
  }
  
  @TRANSFER_RULE_002 {
    condition: "new_module has UNKNOWN workload_type"
    action: "schedule LANGUAGE_DISCOVERY before SELF_OPTIMIZE"
    selection: "no transfer — must discover from scratch"
  }
  
  @TRANSFER_RULE_003 {
    condition: "prior evidence shows REJECTED for relevant workload"
    action: "exclude rejected language from candidate set"
    selection: "skip directly to next-ranked candidate"
  }
}
