@RULEL:SEMANTIC_REPAIR_LOOP:1.1.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .x=steps .p=path .d=design_principle .s=score}
.m{lang=LIN status=SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=repair_chain_must_be_auditably_tracked}
.d{P0=agent_native_first purpose=represent!infer!transform!verify}

.r{R_REPAIR=semantic_mismatch_enters_repair_loop R_BUDGET=repair_has_limited_iterations_and_time R_ORACLE=oracle_and_contract_are_immutable R_CANDIDATE=only_candidate_implementation_may_change R_CLASSIFY=diagnose_mismatch_before_attempting_repair R_TERMINATE=terminate_on_budget_exhaustion R_TRACK=repair_chain_must_be_fully_auditable}

.c{
  oracle_immutable="oracle, schema, expected_result, semantic_contract cannot be modified"
  candidate_mutable="only candidate implementation may be changed"
  max_repair_iterations=3
  max_repair_time_seconds=60
  max_semantic_failures=3
}

.g{
  mismatch_detected=result_hash!=expected_result_hash
  repair_budget_not_exhausted=iterations<max_repair_iterations AND time<max_repair_time_seconds
  repair_success=result_hash==expected_result_hash
  repair_exhausted=iterations>=max_repair_iterations OR time>=max_repair_time_seconds
}

.f{modify_oracle_to_make_hash_match relax_semantic_contract change_expected_result repair_indefinitely_without_budget}

.w{
SEMANTIC_REPAIR_LOOP=generate→verify→mismatch→diagnose→classify→repair→verify→...
termination_states=[INITIAL_PASS, REPAIRED_AND_VERIFIED, REJECTED_AFTER_BUDGET, DIAGNOSTIC_ONLY]
repair_budget={max_iterations: 3, max_time: 60s, max_failures: 3}
repair_chain_is_auditable=each_iteration_recorded_with_hashes_and_diagnosis
}

.x{
1=GENERATE { produce_candidate_implementation }
2=VERIFY { compute_result_hash compare_with_expected }
3=MISMATCH_DETECTED { result_hash!=expected_result_hash }
4=DIAGNOSTICAR { determine_type_of_mismatch }
5=CLASSIFY { categorize_error_type }
6=REPAIR { modify_candidate_implementation_to_fix_error }
7=VERIFY_AGAIN { recompute_result_hash and compare }
8=DECIDE { if match→BENCHMARK; if exhaust→REJECT }
}

.p{
  kernel_candidate=spec/KERNEL_CANDIDATE_V1.rulel
  knowledge=storage/lia_knowledge.dicel
}

.s{
  mismatch_taxonomy=enum{
    canonicalization="output normalization differs",
    ordering="key or element ordering differs",
    numeric_representation="number format or precision differs",
    unicode="unicode normalization or encoding differs",
    regex_semantics="regex groups or matching differs",
    null_absence="null/nil/undefined handling differs",
    hashing_algorithm="hash algorithm implementation differs",
    floating_point="floating point precision differs",
    error_semantics="error handling or propagation differs",
    whitespace="whitespace normalization differs",
    other="uncategorized difference"
  }
}

.s{
  mismatch_diagnosis={
    error_type: mismatch_taxonomy,
    severity: enum{fixable, unfixable, uncertain},
    repair_strategy: string,
    evidence: string
  }
}

.s{
  repair_iteration={
    iteration: int,
    parent_iteration_hash: string,
    timestamp: timestamp,
    elapsed_ms: float,
    diagnosis: mismatch_diagnosis,
    candidate_hash_before: string,
    repair_applied: string,
    candidate_hash_after: string,
    semantic_hash_after: string,
    repair_diff_hash: string,
    result: enum{MATCH, MISMATCH}
  }
}

.s{
  repair_chain={
    language: string,
    module: string,
    workload: string,
    environment_hash: string,
    oracle_version_hash: string,
    initial_candidate_hash: string,
    expected_result_hash: string,
    iterations: [repair_iteration],
    total_elapsed_ms: float,
    termination_state: termination_state,
    benchmark_valid: bool
  }
}

.s{
  repair_budget={
    max_iterations: 3,
    max_time_seconds: 60,
    max_semantic_failures: 3
  }
}

.s{
  termination_state=enum{
    INITIAL_PASS="semantic match on first attempt",
    REPAIRED_AND_VERIFIED="semantic match after repair",
    REJECTED_AFTER_BUDGET="exceeded repair budget, still mismatched",
    DIAGNOSTIC_ONLY="semantic fail, performance is diagnostic only"
  }
}

.s{
  example_repair_chain={
    language: "Python",
    module: "content_hash",
    workload: "string_heavy + regex_heavy",
    initial_candidate_hash: "aaa111",
    expected_result_hash: "def456",
    iterations: [
      {
        iteration: 1,
        diagnosis: {error_type: "whitespace_normalization", severity: "fixable", repair_strategy: "normalize_whitespace"},
        candidate_hash_before: "aaa111",
        repair_applied: "added whitespace normalization",
        candidate_hash_after: "bbb222",
        semantic_hash_after: "bbb222",
        repair_diff_hash: "sha256:repair_1",
        result: "MISMATCH"
      },
      {
        iteration: 2,
        diagnosis: {error_type: "ordering", severity: "fixable", repair_strategy: "sort_keys"},
        candidate_hash_before: "bbb222",
        repair_applied: "added key sorting",
        candidate_hash_after: "ccc333",
        semantic_hash_after: "def456",
        repair_diff_hash: "sha256:repair_2",
        result: "MATCH"
      }
    ],
    total_elapsed_ms: 1200,
    termination_state: "REPAIRED_AND_VERIFIED",
    benchmark_valid: true
  }
}

.s{
  example_exhausted_chain={
    language: "Crystal",
    module: "content_hash",
    workload: "string_heavy + regex_heavy",
    initial_candidate_hash: "xxx999",
    expected_result_hash: "def456",
    iterations: [
      {
        iteration: 1,
        diagnosis: {error_type: "hashing_algorithm", severity: "uncertain", repair_strategy: "implement_same_hash"},
        candidate_hash_before: "xxx999",
        repair_applied: "changed hash algorithm",
        candidate_hash_after: "yyy888",
        semantic_hash_after: "yyy888",
        repair_diff_hash: "sha256:repair_1",
        result: "MISMATCH"
      },
      {
        iteration: 2,
        diagnosis: {error_type: "canonicalization", severity: "fixable", repair_strategy: "normalize_output"},
        candidate_hash_before: "yyy888",
        repair_applied: "added output normalization",
        candidate_hash_after: "zzz777",
        semantic_hash_after: "zzz777",
        repair_diff_hash: "sha256:repair_2",
        result: "MISMATCH"
      },
      {
        iteration: 3,
        diagnosis: {error_type: "ordering", severity: "fixable", repair_strategy: "sort_keys"},
        candidate_hash_before: "zzz777",
        repair_applied: "added key sorting",
        candidate_hash_after: "www666",
        semantic_hash_after: "www666",
        repair_diff_hash: "sha256:repair_3",
        result: "MISMATCH"
      }
    ],
    total_elapsed_ms: 45000,
    termination_state: "REJECTED_AFTER_BUDGET",
    benchmark_valid: false
  }
}

.s{
  example_immutable_protection={
    FORBIDDEN: [
      "modify oracle to match candidate",
      "change expected_result_hash",
      "relax semantic_contract",
      "skip verification step",
      "increase budget without limit"
    ],
    ALLOWED: [
      "modify candidate implementation",
      "add repair logic to candidate",
      "fix algorithm in candidate",
      "adjust encoding in candidate",
      "normalize output in candidate"
    ]
  }
}
