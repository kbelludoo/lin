@RULEL:EXPLANATION_TS_MJS_V1:1.0.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .x=steps .p=path .d=design_principle .s=score}
.m{lang=LIN status=SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=typescript_faster_than_mjs_causal_explanation_unknown}
.d{P0=agent_native_first purpose=represent!infer!transform!verify}

.r{R_DECOMPOSE=decompose_workload_into_components R_CONTROL=control_variables_independently R_ISOLATE=isolate_causal_factors R_ATTRIBUTE=attribute_performance_difference_to_specific_component R_GENERALIZE=extract_generalizable_rule}

.c{
  hypothesis="TypeScript advantage comes from a specific component, not from overall algorithm"
  known_fact="both use crypto.createHash('sha256')"
  observed="TypeScript 5.51µs, MJS 8.26µs"
  components_to_test=[
    "parsing_overhead",
    "string_creation",
    "regex_execution",
    "serialization",
    "buffer_conversion",
    "crypto_call",
    "jit_behavior"
  ]
}

.g{
  explanation_found=causal_attribution_identified
  explanation_not_found=all_components_tested_without_attribution
}

.f{blame_overall_algorithm ignore_specific_components test_only_crypto}

.w{
EXPLANATION_TS_MJS_V1=decompose→control→isolate→attribute→generalize
}

.x{
1=DECOMPOSE { break content_hash into individual components }
2=CONTROL { test each component independently in both TS and MJS }
3=ISOLATE { compare TS vs MJS for each component }
4=ATTRIBUTE { identify which component(s) account for the difference }
5=GENERALIZE { extract rule about when TS is faster than MJS }
}

.p{
  spec=spec/EXPLANATION_TS_MJS_V1.rulel
  test=benchmarks/explanation_ts_mjs_01/test.cjs
  knowledge=storage/lia_knowledge.dicel
}

.s{
  components=enum{
    parsing_overhead="time to parse and compile code",
    string_creation="time to create and manipulate strings",
    regex_execution="time to execute regular expressions",
    serialization="time to serialize data structures",
    buffer_conversion="time to convert between Buffer and string",
    crypto_call="time to call crypto.createHash",
    jit_behavior="time for JIT optimization to warm up"
  }
}
