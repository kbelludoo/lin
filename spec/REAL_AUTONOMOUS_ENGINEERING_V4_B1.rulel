REAL_AUTONOMOUS_ENGINEERING_V4_B1 {

    id: V4_B1_COVERAGE_BALANCE
    version: 2.0.0
    status: ACTIVE
    protocol_frozen: true

    parent: V4_B_FINDING_PRECISION

    objective:
        coverage_balance

    description: >
        V4-B revealed high precision (0.78) but incomplete coverage (58% recall).
        The failure mode was coverage_bias: the agent over-indexed on prototype
        pollution and missed SSRF, header injection, input validation, and
        resource exhaustion bugs.

        V4-B.1 addresses this by changing the ANALYSIS STRATEGY, not adding
        vulnerability-specific rules. The change is from pattern-driven analysis
        to system-model-driven analysis.

    frozen_protocol:
        repository: "axios@v1.14.0"
        oracle: "benchmarks/v4_b_axios/v4_b_oracle.json"
        vulnerability_classes: 7
        trust_model_schema: "knowledge/v4_b1_trust_boundary_model.json"
        data_flow_graph: "knowledge/v4_b1_data_flow_graph.json"
        forbidden:
            - adding_bug_specific_rules
            - "procure SSRF"
            - "procure header injection"
            - any vulnerability-specific probe

    repository:
        name: axios
        version: v1.14.0
        url: https://github.com/axios/axios
        loc: ~5000 (lib/ source only)
        path: benchmarks/v4_b_axios

    analysis_strategy:

        BEFORE (pattern-driven):
            file → pattern match → finding

        AFTER (system-model-driven):
            system_model → trust_boundaries → data_flows → candidate_risks → probe_evaluation

        phases:
            PHASE_1:
                name: system_model_construction
                action: >
                    Build a model of the system. Identify:
                    - All sources (config, URL, headers, events, environment, FormData)
                    - All sinks (http_request, header_output, json_parse, socket, stream)
                    - All trust boundaries (where untrusted crosses into trusted)
                    - All data flows from source to sink through transforms
                output: system_model.json
                metrics:
                    - sources_found / oracle_sources
                    - sinks_found / oracle_sinks
                    - flow_discovery_recall = discovered_flows / oracle_flows
                note: >
                    This phase tests MODELING capability.
                    Low flow_discovery_recall = modeling problem.
                    The agent must discover flows, not classify risks.

            PHASE_2:
                name: probe_execution_on_graph
                action: >
                    For each discovered flow, apply probes:
                    - Does the flow cross a trust boundary?
                    - Are guards sufficient for the trust level?
                    - What is the missing guard?
                    - What is the potential impact?
                output: risk_candidates.json
                metrics:
                    - intervention_precision
                note: >
                    This phase tests REASONING capability.
                    High flow_discovery_recall + low finding_recall = reasoning problem.
                    The probe is a hypothesis verifier, not a detector.

            PHASE_3:
                name: intervention_decision
                action: >
                    For each risk candidate, decide:
                    - CONFIRMED: real bug with sufficient evidence
                    - FALSE_POSITIVE: pattern looks dangerous but is safe
                    - NEEDS_REVIEW: plausible but insufficient evidence
                output: findings.json
                metrics:
                    - precision
                    - recall
                    - false_positive_rate
                note: >
                    This phase tests JUDGMENT capability.
                    Same criteria as V4-B but now informed by system model.

    output_format:
        risk_candidate:
            path: "source → transform → sink"
            boundary: "trust_boundary_id"
            missing_guard: "what validation is absent"
            confidence: "HIGH | MEDIUM | LOW"
            decision: "CONFIRMED | FALSE_POSITIVE | NEEDS_REVIEW"

    metrics:
        intervention_precision:
            formula: "confirmed / (confirmed + false_positives)"
            v4_b_baseline: 0.78
            v4_b1_target: ">= 0.80"
        flow_discovery_recall:
            formula: "discovered_flows / oracle_flows"
            v4_b_baseline: "N/A (V4-B did not produce flow graphs)"
            v4_b1_target: ">= 0.80"
            purpose: "Distinguish discovery failure from reasoning failure"
        risk_surface_coverage:
            formula: "analyzed_boundaries / discovered_boundaries"
            v4_b_baseline: 0.29
            v4_b1_target: ">= 0.80"
        blind_zone_rate:
            formula: "missed_classes / total_classes"
            v4_b_baseline: 0.57
            v4_b1_target: "<= 0.20"

    acceptance_criteria:
        precision: ">= 0.80"
        flow_discovery_recall: ">= 0.80"
        risk_surface_coverage: ">= 0.80"
        blind_zone_rate: "<= 0.20"
        false_positive_rate: "<= 0.20"
        high_impact_false_positives: "= 0"
        unsupported_fix_proposals: "= 0"

    diagnostic_interpretation:
        low_flow_discovery_recall: "modeling problem — agent doesn't discover flows"
        high_fdr_low_finding_recall: "reasoning problem — agent discovers flows but misclassifies"
        high_fdr_high_fring_recall: "agent is both modeler and judge — target state"
}
