@LIN:L1c:1.0
^schema_once ^ops=LIN_SEMANTIC_SPEC
~G{?=if #=for ^=ret :else}

$K{VERSION="1.0.0" LAYER="semantic" GOAL="representacao_intencao_verificavel"}

@SEMANTIC_LAYER {

  @PRIMITIVAS {

    @CONCEPT {
      descricao: "Unidade semântica nomeada. Representa uma intenção ou capacidade."
      sintaxe: "@CONCEPT <Nome> { INPUT, RULE, CONSTRAINT, VERIFY, OUTPUT, EFFECT }"
      exemplo: "@CONCEPT CalculateTotal { ... }"
      regra: "Um CONCEPT é puro até que declare efeitos explícitos"
      hash: "Identificado por content-hash do corpo canônico (Unison style)"
    }

    @INPUT {
      descricao: "Entradas tipadas com refinements opcionais"
      sintaxe: "INPUT: { <nome>: <tipo>{<constraint>}, ... }"
      exemplo: "INPUT: { items: list{non_empty}, discount: int{0..100} }"
      regra: "Refinements geram guards automáticos no target de compilação"
    }

    @RULE {
      descricao: "Transformação declarativa: o que fazer, não como"
      sintaxe: "RULE: { <binding> = <expressao>, ... }"
      exemplo: "RULE: { total = sum(items.price), final = total * (1 - discount/100) }"
      regra: "Rules são puras por default. Ordem não importa (declarativo)."
    }

    @CONSTRAINT {
      descricao: "Invariantes que devem ser verdadeiros antes e depois da execução"
      sintaxe: "CONSTRAINT: { <predicado>, ... }"
      exemplo: "CONSTRAINT: { final >= 0, final <= total }"
      regra: "Violação de constraint = erro verificável, não silencioso"
    }

    @VERIFY {
      descricao: "Propriedades verificáveis após execução"
      sintaxe: "VERIFY: { <propriedade>, ... }"
      exemplo: "VERIFY: { precision = currency, type(final) = number }"
      regra: "Verificações rodam automaticamente em modo debug/test"
    }

    @OUTPUT {
      descricao: "Saída tipada do conceito"
      sintaxe: "OUTPUT: { <nome>: <tipo>{<constraint>} }"
      exemplo: "OUTPUT: { final: float{>=0} }"
    }

    @EFFECT {
      descricao: "Efeitos colaterais declarados explicitamente (Koka style)"
      sintaxe: "EFFECT: { <tipo>, ... }"
      valores: "pure | io | state | async | fail | random | time | agent"
      regra: "Conceito sem EFFECT é implicitamente pure"
    }

    @TARGET {
      descricao: "Alvo de execução preferido ou obrigatório"
      sintaxe: "TARGET: { prefer: <lang>, require: <lang>, fallback: <lang> }"
      exemplo: "TARGET: { prefer: rust, fallback: js }"
      regra: "Runtime decide target final baseado em disponibilidade e perfil"
    }
  }

  @EXEMPLO_COMPLETO {
    codigo: "
      @CONCEPT CalculatePrice {
        INPUT: {
          items: list{non_empty}
          discount: int{0..100}
        }
        RULE: {
          subtotal = sum(items.price)
          final = subtotal * (1 - discount / 100)
        }
        CONSTRAINT: {
          final >= 0
          final <= subtotal
        }
        VERIFY: {
          precision = currency
          type(final) = number
        }
        OUTPUT: {
          final: float{>=0}
        }
        EFFECT: { pure }
        TARGET: { prefer: rust, fallback: js }
      }
    "
  }

  @FLUXO_EXECUCAO {
    1: "IA gera CONCEPT em LIN semântico"
    2: "Parser extrai INPUT, RULE, CONSTRAINT, VERIFY, EFFECT, TARGET"
    3: "Verificador valida constraints e refinements estaticamente"
    4: "Runtime de decisão escolhe target baseado em: perfil + disponibilidade + EFFECT"
    5: "Compilador emite código executável para o target escolhido"
    6: "Runtime executa e verifica VERIFY em runtime"
    7: "Content-hash registra o CONCEPT para cache e deduplicação"
  }

  @VANTAGEM_VS_CODIGO_DIRETO {
    1: "IA declara INTENÇÃO, não implementação"
    2: "Constraints são verificáveis ANTES da execução"
    3: "Mesmo CONCEPT compila para qualquer target"
    4: "Hash semântico permite cache universal de resultados"
    5: "Effects explícitos permitem sandboxing automático"
    6: "Runtime pode re-otimizar target sem alterar o CONCEPT"
  }
}
