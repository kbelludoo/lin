@RULEL:LANGUAGE_KNOWLEDGE_V2:1.0.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .x=steps .p=path .d=design_principle .s=score}
.m{lang=LIN status=SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=knowledge_graph_not_flat_catalog}
.d{P0=agent_native_first purpose=represent!infer!transform!verify}

.r{R_GRAPHS=language_knowledge_is_a_graph_not_a_table R_EVIDENCE=every_property_must_have_evidence R_VERSION=properties_belong_to_version_specific_snapshots R_TEMPORAL=knowledge_has_history_and_evolution R_GAP=unknown_entries_generate_experiment_requests R_CONFIDENCE=confidence_derived_from_evidence_not_opinion}

.c{
  identity_layer=language_identity_and_classification
  static_layer=declared_properties_from_spec
  observed_layer=discovered_by_probe
  empirical_layer=measured_by_benchmark
  historical_layer=experimental_evidence_with_provenance
}

.g{
  identity=name_aliases_family_paradigm
  static=typing_memory_execution_gc_ownership_compilation_ffi_concurrency
  observed=compiler_found_interpreter_found_version_compile_success_runtime_success
  empirical=cpu_memory_latency_allocations_compile_time_binary_size_startup
  historical=benchmark_run_workload_hash_environment_hash_result_hash_confidence
}

.f{store_knowledge_as_flat_notes attach_properties_without_evidence assume_properties_are_absolute ignore_version_specificity}

.w{
LANGUAGE_KNOWLEDGE_V2=identity→static→observed→empirical→historical
knowledge_is_graph=language↔capability↔workload↔component↔experiment↔artifact↔evidence
every_property_must_carry_evidence=property_status_must_be_DOCUMENTED_OBSERVED_or_VERIFIED
unknown_generates_gap=UNKNOWN_fitness_entry_creates_experiment_request
}

.x{
1=DEFINE_IDENTITY { name aliases family paradigm homepage license }
2=DEFINE_STATIC { typing memory execution gc ownership compilation ffi concurrency macro reflection generics metaprogramming }
3=OBSERVE { compiler_found interpreter_found version compile_success runtime_success feature_probes }
4=MEASURE { cpu memory latency allocations compile_time binary_size startup workload_fitness }
5=RECORD { benchmark_run workload_hash environment_hash source_hash binary_hash result_hash confidence timestamp }
6=REVERSE { knowledge_gaps generate_experiment_requests }
7=RELATE { compiles_to interoperates_with embeds targets similar_to }
8=COST { compile_time toolchain_size dependency_count binary_size cross_compile deployment_complexity FFI_cost debugging_support ecosystem_maturity }
}

.p{
  self_optimize=spec/LIN_SELF_OPTIMIZE.rulel
  discovery=spec/LIN_LANGUAGE_DISCOVERY.rulel
  kernel_candidate=spec/KERNEL_CANDIDATE_V1.rulel
  knowledge=storage/lia_knowledge.dicel
}

.s{
  language_graph_node={
    node_id: string,
    node_type: enum{Language, Capability, Workload, Component, Experiment, Artifact, Evidence},
    properties: [{key: string, value: string, status: enum{UNKNOWN, DISCOVERED, OBSERVED, DOCUMENTED, BENCHMARKED, VERIFIED, SUPPORTED, REJECTED, STALE}}],
    edges: [{target: string, relation: string, evidence: string}]
  }
}

.s{
  language_identity={
    name: string,
    aliases: [string],
    family: string,
    paradigms: [string],
    homepage: string,
    license: string
  }
}

.s{
  language_static={
    typing_model: string,
    memory_model: string,
    execution_model: string,
    gc: string,
    ownership: string,
    compilation_model: string,
    target_platforms: [string],
    ffi: string,
    concurrency_model: string,
    macro_system: string,
    reflection: string,
    pattern_matching: string,
    generics: string,
    metaprogramming: string
  }
}

.s{
  language_observed={
    compiler_found: bool,
    interpreter_found: bool,
    version_detected: string,
    compile_success: bool,
    runtime_success: bool,
    feature_probes: [{feature: string, success: bool, evidence: string}]
  }
}

.s{
  language_empirical={
    cpu_us: float,
    memory_bytes: int,
    latency_p99_us: float,
    allocations: int,
    compile_time_ms: float,
    binary_size_bytes: int,
    startup_ms: float
  }
}

.s{
  language_historical={
    benchmark_run: string,
    workload_hash: string,
    environment_hash: string,
    source_hash: string,
    binary_hash: string,
    result_hash: string,
    confidence: float,
    confidence_basis: {independent_runs: int, workloads: int, versions: int},
    timestamp: timestamp
  }
}

.s{
  workload_fitness_entry={
    language: string,
    workload_type: string,
    workload_combination: [string],
    fitness: enum{STRONG, MEDIUM, WEAK, REJECTED, UNKNOWN},
    evidence: [{benchmark: string, workload_hash: string, environment_hash: string, result_hash: string}],
    provenance: {module: string, confidence: float}
  }
}

.s{
  capability_entry={
    capability: string,
    status: enum{UNKNOWN, DISCOVERED, OBSERVED, DOCUMENTED, BENCHMARKED, VERIFIED, SUPPORTED, REJECTED, STALE},
    source: string,
    evidence: string
  }
}

.s{
  knowledge_state=enum{
    UNKNOWN="no evidence yet",
    DISCOVERED="found in environment",
    OBSERVED="probed successfully",
    DOCUMENTED="from spec or docs",
    BENCHMARKED="measured in benchmark",
    VERIFIED="proven by test or proof",
    SUPPORTED="actively maintained and working",
    REJECTED="tested and failed",
    STALE="evidence outdated or superseded"
  }
}

.s{
  adoption_cost={
    compile_time_ms: float,
    toolchain_size_mb: float,
    dependency_count: int,
    binary_size_bytes: int,
    cross_compile: bool,
    deployment_complexity: enum{simple, moderate, complex},
    startup_ms: float,
    FFI_cost: enum{native, wrapper_needed, manual_binding},
    debugging_support: enum{excellent, good, limited, poor},
    ecosystem_maturity: enum{mature, growing, nascent, abandoned}
  }
}

.s{
  language_relations={
    compiles_to: [string],
    interoperates_with: [string],
    embeds: [string],
    targets: [string],
    similar_to: [string]
  }
}

.s{
  knowledge_gap={
    gap_id: string,
    language: string,
    workload: string,
    status: enum{UNKNOWN, DISCOVERED},
    priority: enum{HIGH, MEDIUM, LOW},
    reason: string,
    proposed_experiment: string,
    estimated_cost: enum{LOW, MEDIUM, HIGH},
    information_value: float
  }
}

.s{
  example_rust_entry={
    identity: {
      name: "Rust",
      family: "systems",
      paradigms: ["imperative", "functional"]
    },
    static: {
      memory: "ownership",
      gc: "none",
      execution: "native",
      concurrency: "strong"
    },
    capabilities: [
      {capability: "graph_processing", status: "VERIFIED", source: "SELF_OPTIMIZE_02"},
      {capability: "concurrency", status: "VERIFIED", source: "SELF_OPTIMIZE_02"},
      {capability: "regex_processing", status: "DOCUMENTED", source: "language_spec"}
    ],
    fitness: [
      {
        workload: "string_heavy + regex_heavy",
        status: "REJECTED",
        evidence: [{benchmark: "SELF_OPTIMIZE_02", result_hash: "...", semantic_equivalence: "FAIL"}]
      },
      {
        workload: "graph_heavy + concurrency",
        status: "UNKNOWN"
      }
    ],
    relations: {
      compiles_to: ["native", "WASM"],
      interoperates_with: ["C", "C++"],
      similar_to: ["Zig"]
    }
  }
}

.s{
  example_query_results={
    query_1: "Qual linguagem ainda não testei para HashCons?",
    answer: "Crystal, Nim, Zig, C++, Lua, OCaml — todos UNKNOWN para IR_HashCons",
    
    query_2: "Qual backend tem evidência forte para grafos concorrentes?",
    answer: "Rust — VERIFIED para graph_heavy + concurrency (SELF_OPTIMIZE_02)",
    
    query_3: "Por que Rust foi rejeitado para este módulo?",
    answer: "semantic_mismatch + performance_regression (SELF_OPTIMIZE_02)",
    
    query_4: "Quais linguagens desconhecidas podem preencher esse knowledge gap?",
    answer: "Crystal (HIGH priority, binary exists), Nim (MEDIUM, compiler needed)",
    
    query_5: "Qual experimento tem maior valor de informação?",
    answer: "Crystal for string_heavy — binary exists, no cost, high potential"
  }
}
