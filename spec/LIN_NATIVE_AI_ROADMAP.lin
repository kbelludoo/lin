@LIN:L1c:1.0
^schema_once ^ops=LIN_NATIVE_AI_ROADMAP
~G{?=if #=for ^=ret :else}

$K{VERSION="1.0.0" GOAL="lingua_nativa_ia_maquinas" STATUS="em_implementacao"}

@ROADMAP {

  @FASE_1_ESPECIFICACAO {
    titulo: "Gramática Formal e Especificação Publicável"
    prioridade: CRITICA
    status: PENDENTE

    @TAREFAS {
      1: "Escrever gramática PEG/BNF completa em spec/LIN_GRAMMAR.peg"
      2: "Documentar cada sigilo e sua semântica (!fn ?if #for ^ret :else $K =ex ~G)"
      3: "Definir formalmente Refinement Types (int{0..100}, str{len<=N})"
      4: "Definir formalmente Effect Types (~effects{io,state,async,pure})"
      5: "Definir formalmente Reference Capabilities (iso,val,ref,tag)"
      6: "Publicar spec como artefato consumível por LLMs (context window friendly)"
    }

    @GRAMATICA_RESUMO {
      header: "@LIN:L1c:<version>"
      meta: "^key=value (schema_once, lossy, ops)"
      grammar: "~G{?=if #=for ^=ret :else}"
      consts: "$K{KEY=value ...}"
      function: "!nome(params){corpo}"
      exports: "=ex{fn1,fn2,...}"
      refinement: "param:tipo{constraint}"
      effects: "~effects{io,state,pure,...}"
      refcap: "~cap{iso|val|ref|tag}"
      if: "?(cond){then}:?(cond){elseif}:{else}"
      for: "#(init;cond;step){body}"
      while: "#(;cond;){body}"
      return: "^expr"
      assign: "id=expr"
      comment: "// texto"
    }
  }

  @FASE_2_SELF_HOSTING {
    titulo: "Compilador LIN Escrito em LIN"
    prioridade: CRITICA
    status: PENDENTE

    @TAREFAS {
      1: "Reescrever parseLia (parser principal) em LIN → compiler.lin"
      2: "Reescrever body_ast.mjs (parser de statements) em LIN → body_ast.lin"
      3: "Reescrever emit_shared.mjs (rewrite de expressões) em LIN → emit_shared.lin"
      4: "Reescrever cada emitter (emit_js, emit_py, ...) em LIN"
      5: "Bootstrap: compilar compiler.lin → compiler.compiled.cjs"
      6: "Usar compiler.compiled.cjs para compilar compiler.lin novamente"
      7: "Gate: output do passo 5 == output do passo 6 (hash idêntico = self-hosting)"
    }

    @REGRA {
      loop: "escrever_lin → compilar → testar → se_falha_corrigir_COMPILADOR_nao_LIN → recompilar"
      nucleo_imutavel: "NUNCA alterar semântica do parser para facilitar emissão"
      validacao: "hash_semantico do output deve ser identico entre bootstrap passes"
    }
  }

  @FASE_3_BENCHMARK_IA {
    titulo: "Benchmark Formal: LIN vs Python vs TypeScript para IAs"
    prioridade: ALTA
    status: PENDENTE

    @METRICAS {
      1: "Tokens por operação (quantos tokens um LLM gasta para expressar a mesma lógica)"
      2: "Taxa de erro de geração (% de código gerado que falha na compilação)"
      3: "Determinismo de saída (mesma prompt → mesmo código em N tentativas)"
      4: "Tempo de compilação + verificação cruzada"
      5: "Cobertura de verificação (quantas linguagens-alvo validam o mesmo hash)"
      6: "Tamanho do context window consumido (bytes por função)"
    }

    @METODOLOGIA {
      corpus: "100 funções extraídas de repos famosos (chalk, nanoid, dayjs, underscore)"
      modelos: "GPT-4, Claude, Gemini, Llama — cada um gera em LIN, Python e TS"
      validacao: "compilação + hash semântico + execução de testes do repo original"
      publicacao: "resultados em tabela auditável com reprodução via script"
    }
  }

  @FASE_4_ECOSSISTEMA {
    titulo: "Ecossistema Mínimo Viável"
    prioridade: MEDIA
    status: PENDENTE

    @TAREFAS {
      1: "Package manager: lin install <pacote> (resolve dependências por content hash)"
      2: "LSP: autocomplete e diagnósticos em editores (VS Code, Cursor)"
      3: "REPL: lin repl (compilação e execução in-memory interativa)"
      4: "Documentação: site com exemplos, tutorial e referência da gramática"
      5: "Registry: repositório central de funções indexadas por hash semântico"
    }
  }

  @FASE_5_FRAMEWORK_AGENTE {
    titulo: "Framework de Agente Autônomo 100% em LIN"
    prioridade: ALTA
    status: PENDENTE

    @TAREFAS {
      1: "Definir primitivas de agente em LIN (spawn, send, receive, supervise)"
      2: "Implementar orquestrador multi-agente com supervision tree"
      3: "Implementar pipeline de inferência (prompt → LIN → compile → execute → verify)"
      4: "Implementar loop de auto-correção (falha → diagnóstico → patch → recompile)"
      5: "Testar com agente real que clona repos, reescreve em LIN e publica"
    }

    @PRIMITIVAS_AGENTE {
      spawn: "!spawn(name,handler,opts) → actor"
      send: "actor.send(msg) → {ok:true|false}"
      supervise: "!supervise(children,strategy) → supervisor"
      effects: "~effects{agent,io,async}"
      refcap: "~cap{iso} para mensagens entre agentes (zero data race)"
    }
  }

  @FASE_6_ADOCAO {
    titulo: "Publicação e Adoção por Outros Modelos"
    prioridade: ALTA
    status: FUTURO

    @TAREFAS {
      1: "Publicar spec formal como RFC/documento técnico"
      2: "Treinar/fine-tune modelos com corpus de LIN (código + gramática + exemplos)"
      3: "Integrar como output format em pipelines de código de IA"
      4: "Benchmark público comparando LIN vs linguagens tradicionais para geração de código"
      5: "Contribuições externas: abrir para comunidade com governance clara"
    }
  }
}

@ORDEM_EXECUCAO {
  agora: "FASE_1 (gramática PEG) + FASE_2 (self-hosting do parser)"
  proximo: "FASE_3 (benchmark) + FASE_5 (framework agente)"
  depois: "FASE_4 (ecossistema) + FASE_6 (adoção)"
}
