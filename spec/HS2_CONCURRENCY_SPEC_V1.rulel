@RULEL:HS2_CONCURRENCY_SPEC_V1:1.0.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .x=steps .p=path .d=design_principle}
.m{lang=LIN status=FROZEN_SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=concurrent_shared_state_linearizability_evaluation}
.d{P0=linearizability_by_contract purpose=mediate!serialize!reconcile!prevent_deadlock}

.r{
  R_LINEARIZABILITY=strictly_enforce_atomic_linearizability_on_critical_state_objects
  R_TOCTOU_SAFETY=stale_reads_must_be_rejected_on_commit_if_version_or_state_mutated
  R_DYNAMIC_INVAL=mid_flight_revocations_must_atomically_invalidate_dependent_in_flight_plans
  R_DEADLOCK_FREEDOM=detect_mutual_delegation_cycles_via_total_order_and_break_cleanly
}

.c{
  interleaving_schema={
    scenario_id: string,
    interleaving_id: string,
    event_order: list_of_operations,
    linearization_class: string,
    expected_final_invariants: map
  }
  concurrency_metrics={
    conflicts_handled: integer,
    rollbacks_executed: integer,
    deadlocks_observed: integer,
    invariant_violations: integer,
    escaped_illegal_effects: integer
  }
}

.g{
  GATE_HS2_SAFETY=invariant_violations==0 AND escaped_illegal_effects==0
  GATE_HS2_CONSISTENCY=state_reconciliation_passed AND linearizability_verified
  GATE_HS2_LIVENESS=deadlocks_observed==0 AND timeouts_observed==0
  GATE_HS2_OVERALL=GATE_HS2_SAFETY AND GATE_HS2_CONSISTENCY AND GATE_HS2_LIVENESS
}

.f{
  permit_commit_on_stale_read_without_version_check
  allow_corrupt_partial_writes_under_concurrent_collision
  allow_illegal_downstream_action_after_cascade_revocation
  presume_deadlock_freedom_beyond_tested_frozen_interleavings
}

.w{
  HS2_EVAL=evaluate_LIN_state_machine_under_multi_agent_concurrency
}

.x{
  1=load_HS2_CONCURRENCY_SPEC_V1
  2=initialize_canonical_shared_state_per_scenario_C01_to_C10
  3=execute_frozen_interleavings_I001_to_I010_with_LIN_concurrent_mediator
  4=audit_linearizability_and_state_reconciliation
  5=verify_stale_read_rejections_and_atomic_rollbacks
  6=check_GATE_HS2_SAFETY_and_GATE_HS2_CONSISTENCY_and_GATE_HS2_LIVENESS
  7=persist_evidence_hs2_concurrency.json
}

.p{
  spec_json=spec/HS2_CONCURRENCY_SPEC_V1.json
  orchestrator=scripts/run_hs2_concurrency.mjs
  evidence=artifacts/evidence_hs2_concurrency.json
}
