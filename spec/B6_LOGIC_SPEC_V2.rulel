@RULEL:B6_LOGIC_SPEC_V2:2.0.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .x=steps .p=path .d=design_principle}
.m{lang=LIN status=FROZEN_SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=paradigm_research_scalability_cycle_proof}
.d{P0=agent_native_first purpose=represent!infer!prove!verify}

.r{
  R_SCALE=evaluate_1000_facts_dense_graphs_with_cycles
  R_PROOF=canonical_proof_dag_hash_independent_of_discovery_order
  R_NEGATIVE=finite_failure_distinguished_from_bound_exceeded
  R_CYCLE=cycle_safe_resolution_via_tabling_or_loop_memoization
}

.c{
  canonical_input=JSON_parse!canonical_serialize!SHA256("LIN/B6_INPUT/0.2\0"||bytes)
  canonical_result=JSON_parse!canonical_serialize!SHA256("LIN/B6_RESULT/0.2\0"||bytes)
  canonical_proof=JSON_parse!canonical_serialize!SHA256("LIN/PROOF_DAG/0.1\0"||bytes)

  queries=[Q1_existence, Q2_enumerate, Q3_constrained, Q4_proof_dag, Q5_negative_finite_failure, Q6_deep_multi_hop]

  q4_proof_schema={
    goal: map,
    nodes: list_of_ordered_fact_and_goal_nodes,
    edges: list_of_ordered_derivation_edges,
    derivation_length: integer
  }
}

.g{
  input_integrity=engine_input_hash==expected_input_hash
  q1_correct=q1_result_hash==expected_q1_hash
  q2_correct=q2_result_hash==expected_q2_hash
  q3_correct=q3_result_hash==expected_q3_hash
  q4_correct=q4_result_hash==expected_q4_hash AND q4_proof_hash==expected_q4_proof_hash
  q5_correct=q5_status==NO_SOLUTION AND q5_finite_failure==TRUE
  q6_correct=q6_result_hash==expected_q6_hash
  determinism=run1_all_hashes==run2_all_hashes==run3_all_hashes
  termination=all_queries_terminate_under_bound_50000_steps

  GATE_B6_V2=input_integrity AND q1_correct AND q2_correct AND q3_correct AND q4_correct AND q5_correct AND q6_correct AND determinism AND termination
}

.f{
  confuse_step_bound_with_absence_of_solution
  non_canonical_proof_dag_ordering
  allow_infinite_loops_on_cycles
  measure_performance_before_GATE_B6_V2_is_TRUE
}

.w{
  B6_V2_EVAL=measure_scalability_and_proof_generation
  ENGINES=Prolog!Rust!Nim
}

.x{
  1=load_B6_LOGIC_SPEC_V2
  2=verify_B6_V2_INPUT_HASH
  3=run_candidate_engine_on_Q1_to_Q6
  4=extract_bindings_and_Q4_proof_dag
  5=canonicalize_outputs_and_proof_dag
  6=verify_all_validation_gates→compute_GATE_B6_V2
  7=record_normalized_cost_metrics
  8=persist_evidence_b6_v2.json
}

.p{
  spec_json=spec/B6_LOGIC_SPEC_V2.json
  generator=scripts/b6_logic_v2_generator.mjs
  orchestrator=scripts/run_b6_logic_v2.mjs
  evidence=artifacts/evidence_b6_v2_logic.json
}
