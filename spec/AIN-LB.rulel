}

.w{
  NOW=freeze_this_spec;DO_NOT_implement_yet
  NEXT=harness_py!ts!rust
  LATER=add_LIN_only_after_harness_validated_on_non_LIN
  CLR002=LIN_effect_repair_protocol;detect!explain!propose=PASS;apply=CONDITIONAL_never_automatic
  CLR002_GRAPH=operation->effect->capability->allowed_context;database.write_requires_io
  CLR002_POLICY=REPAIR_ALLOWED_only_if_proposed_change+semantic_proof+invariant_preserved;otherwise_DENIED
  CLR002_SCOPE=fixture_declarations_only;actual_effect_analyzer_not_wired_into_compiler;runner_must_not_claim_compiler_semantics
  CLR002_SAFETY=proof_before_apply+no_target_mutation+EXISTING_semantic_hash_preserved_after_approved_change
  CLR002_PAUSE=C1-C5_and_M006_paused;no_LLM;no_new_Dicel
}

.clr006{
  id=CLR-006
  name=autonomous_design_choice
  status=ACTIVE_DETERMINISTIC_PROTOCOL_EXTERNAL_AGENT_INPUT
  task="system is becoming slow; improve performance while preserving contract"
  graph=CLR004_real_six_module_graph_plus_CLR005_artifacts
  input=external_agent_IR_or_proposal
  policy=artifact_load_then_CLR005_policy_and_gates
  causal=intent->hypothesis->affected_modules->effects->caps->performance_contract->proof->decision
  contract=preserve_declared_contracts;effects=pure|memory;caps=memory|cpu;forbid=io|storage
  proposals=baseline!cache_memory!index_algorithm!parallelism!persistent_cache
  decisions=ACCEPT!DENIED!CONDITIONAL
  accept=proof_verified AND constraints_preserved AND no_violations AND no_approval_pending
  conditional=zero_hard_violations AND approval_or_proof_pending
  denied=hard_violation
  records=proposal_id!hypothesis!semantic_distance!affected_modules!constraints_preserved!violations!repairs!proof_status!approval_required!attempts!tokens_input!tokens_output!time_ms!agent_unobserved!model_runs!decision!causal_result
  no_fake_scores=1
  agent_unobserved=true
  model_runs=0
  limitation=deterministic_runner_proves_judge_and_protocol_only;does_not_claim_best_design_discovery
  nucleus=UNTOUCHED
  M006=PAUSED
}

.s{
  score=AI_DEVELOPMENT_SCORE
  weights=reliability_0.30+first_pass_0.20+context_efficiency_0.20+semantic_recovery_0.20+regression_stability_0.10
  normalize=each_submetric_to_0..1_before_weighting
  penalties=minus_unnecessary_changes_per_run;minus_error_count_per_run
  report_first=semantic_recovery;then_compression_ratio;then_composite
  expected_territory=LIN_wins_on_context_loss+maintenance_after_many_changes+explanation+token_reduction
  expected_not=LIN_wins_on_exec_speed+bin_size+ecosystem;those_are_out_of_scope
}

