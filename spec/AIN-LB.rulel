  first_pass_success=compile_AND_test_pass_on_attempt_1_ratio
  regression_stability=invariants_unbroken_across_evolution
  compression_ratio=tokens_traditional / tokens_lin
  unnecessary_changes=files_touched_without_need_after_recovery
  repair_efficiency=attempts+tokens+time_until_first_success;LIN=invariant_break_explicit_cause_vs_trad=compiler_error_interpret
  ccr_recovery_accuracy=0_destroyed_arch!1_partial_fix!2_correct_fix;judge_based
  ccr_reconstruction_tokens=tokens_to_rebuild_mental_model_after_amnesia
  ccr_wrong_assumptions=times_IA_recreates_structure_whose_semantic_hash_exists;LIN_oracle=buildContentRegistry_INV_SEMANTIC_DUP
  ccr_partial_memory=remove_50pct_files_then_infer_rest;measure_reconstructability
}

