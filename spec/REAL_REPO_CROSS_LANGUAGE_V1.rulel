@RULEL:REAL_REPO_CROSS_LANGUAGE_V1:1.0.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .x=steps .p=path .d=design_principle .s=score}
.m{lang=LIN status=SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=lin_must_demonstrate_cross_language_semantic_preservation}
.d{P0=agent_native_first purpose=represent!infer!transform!verify}

.r{R_SOURCE=source_repository_must_have_tests R_TARGET=target_implementation_must_be_equivalent R_API=api_equivalence_must_be_verified R_PERFORMANCE=real_workload_performance_must_be_measured R_MANUAL=manual_interventions_must_be_tracked}

.c{
  source_criteria=[
    "open_source",
    "has_automated_tests",
    "has_clear_public_api",
    "small_to_medium_size",
    "measurable_performance"
  ]
  pipeline="Python → LIN-IR → Rust"
  validation="test_equivalence + api_equivalence + performance_comparison"
}

.g{
  source_selected=repo_meets_criteria
  python_tests_pass=100%_original_tests_pass
  rust_implementation_complete=Rust_version_compiles
  rust_tests_pass=equivalent_tests_pass
  api_equivalence=outputs_match_for_all_test_cases
  performance_validated=performance_metrics_recorded
}

.f{skip_api_validation skip_performance_measurement allow_manual_edits}

.w{
REAL_REPO_CROSS_LANGUAGE_V1=select→baseline→convert→implement→test→benchmark→compare
}

.x{
1=SELECT { choose Python repository meeting criteria }
2=BASELINE { record Python performance metrics }
3=CONVERT { transform Python to LIN-IR representation }
4=IMPLEMENT { generate Rust implementation from LIN-IR }
5=TEST { run equivalent test suite on Rust version }
6=BENCHMARK { compare real workload performance }
7=COMPARE { measure API equivalence and behavior preservation }
}

.p{
  knowledge=storage/lia_knowledge.dicel
  real_repo_ms=benchmarks/real_repo_ms
}

.s{
  validation_gates=enum{
    GATE_PYTHON_TESTS_PASS="100% original Python tests pass",
    GATE_RUST_COMPILES="Rust implementation compiles without errors",
    GATE_RUST_TESTS_PASS="equivalent tests pass on Rust version",
    GATE_API_EQUIVALENCE="outputs match for all test cases",
    GATE_BEHAVIOR_EQUIVALENCE="edge cases and exceptions match",
    GATE_PERFORMANCE_RECORDED="performance metrics captured and compared"
  }
  metrics=enum{
    test_pass_rate="percentage of tests passing in each language",
    api_match_rate="percentage of test cases with identical output",
    performance_ratio="Rust_time / Python_time",
    manual_edits="number of human interventions required",
    loc_source="lines of code in source language",
    loc_generated="lines of code in generated language"
  }
}
