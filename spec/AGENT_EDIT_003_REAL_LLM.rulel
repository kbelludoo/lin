@RULEL:AGENT_EDIT_003_REAL_LLM:1.0.0
~M{.name="AGENT_EDIT_003_REAL_LLM" .type="GENUINE_LLM_AUTONOMOUS_EDIT_BENCHMARK" .status="PROTOCOL_FROZEN"}
.doc{
  objective="Medir agência cognitiva de um LLM real operando via tool-calling para diagnosticar perfil de workload, localizar ponto de intervenção, decidir estratégia e aplicar patch no filesystem."
}
.invariants{
  prompt_free_of_solution=true
  no_target_block_in_harness=true
  no_simulate_agent_decision=true
  tools_provided=[view_file, read_profile, replace_file_content, run_build, run_benchmark]
  telemetry=[tool_call_sequence, prompt_tokens, candidate_tokens, git_diff_sha, lines_added, lines_removed, build_status, oracle_score]
  formula="P(Complete) = P(D) * P(E|D) * P(B|E) * P(R|B)"
}
.workload_profile{
  metric="random_seek_distance"
  baseline_value=370412
  target_threshold=150000
}
.public_contract{
  symbol="!dispatch_next(queue:num, current_floor:num, target_floor:num)"
  inputs=[
    { input: [1, 2, 5], expected: 1 },
    { input: [1, 5, 2], expected: -1 },
    { input: [1, 4, 4], expected: 1 },
    { input: [0, 2, 5], expected: 0 },
    { input: [0, 5, 2], expected: 0 }
  ]
}
