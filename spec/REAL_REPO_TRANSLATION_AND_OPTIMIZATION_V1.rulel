@RULEL:REAL_REPO_TRANSLATION_AND_OPTIMIZATION_V1:1.0.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .x=steps .p=path .d=design_principle .s=score}
.m{lang=LIN status=SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=lin_must_demonstrate_real_world_code_translation_and_optimization}
.d{P0=agent_native_first purpose=represent!infer!transform!verify}

.r{R_BASELINE=establish_baseline_before_conversion R_EQUIVALENCE=functional_equivalence_must_be_verified R_BENCHMARK=performance_comparison_must_be_quantified R_OPTIMIZATION=evidence_based_optimization_must_improve_metrics R_VALIDATION=all_gates_must_pass}

.c{
  repository_criteria=[
    "open_source",
    "has_automated_tests",
    "has_measurable_performance",
    "medium_size",
    "active_maintenance"
  ]
  pipeline="TS → DICE-L → LIN → TS → benchmark → optimize"
  target_languages=["TypeScript", "Python", "Rust"]
}

.g{
  repository_selected=repo_meets_criteria
  baseline_established=original_performance_recorded
  conversion_complete=LIN_representation_generated
  compilation_success=BUILD_GATE_passes
  test_equivalence=100%_tests_pass
  performance_validated=LIN_performance>=baseline_or_improvement_proven
}

.f{skip_baseline skip_test_equivalence optimize_without_evidence}

.w{
REAL_REPO_TRANSLATION_AND_OPTIMIZATION_V1=select→baseline→convert→compile→test→benchmark→optimize
}

.x{
1=SELECT { choose repository meeting criteria }
2=BASELINE { record original performance metrics }
3=CONVERT { transform code to LIN representation }
4=COMPILE { generate target backend code }
5=TEST { run original test suite on LIN version }
6=BENCHMARK { compare performance metrics }
7=OPTIMIZE { apply evidence-based improvements }
}

.p{
  knowledge=storage/lia_knowledge.dicel
  kernel_candidate=spec/KERNEL_CANDIDATE_V1.rulel
}

.s{
  gates=enum{
    GATE_BUILD_SUCCESS="LIN version compiles without errors",
    GATE_TEST_EQUIVALENCE="100% original tests pass on LIN version",
    GATE_BEHAVIOR_EQUIVALENCE="output matches original for all test cases",
    GATE_PERFORMANCE_COMPARISON="performance metrics recorded and compared",
    GATE_OPTIMIZATION_VALIDATION="optimization improvements measured and verified"
  }
  metrics=enum{
    test_pass_rate="percentage of tests passing",
    latency_ratio="LIN_latency / Original_latency",
    memory_ratio="LIN_memory / Original_memory",
    binary_size_ratio="LIN_size / Original_size",
    optimization_gain="percentage improvement after optimization"
  }
}
