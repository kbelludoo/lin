@RULEL:LIN_SELF_OPTIMIZE:1.1.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .x=steps .p=path .d=design_principle .s=score}
.m{lang=LIN status=SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=parallel_candidate_exploration_not_single_hypothesis}
.d{P0=agent_native_first purpose=represent!infer!transform!verify}

.r{R_EVIDENCE=decision_requires_benchmark_plus_semantic_verification R_NO_OPINION=no_migration_without_measured_evidence R_NUCLEUS=nucleus_mutable_classes_A_B_only R_CLASS_C=architectural_changes_require_human_approval R_MULTI=target_selection_per_module_not_per_project R_SAME=oracle_workload_semantics_must_be_identical_across_variants R_BASELINE=baseline_language_must_be_in_comparison R_PARALLEL=explore_multiple_candidates_in_parallel R_PROFILE=language_selection_from_workload_profile_not_prior_belief R_KNOWLEDGE_GAP=unknown_fitness_triggers_discovery_experiment R_FITNESS_HYPOTHESIS=fitness_is_hypothesis_not_decision_updateable_with_evidence}

.c{semantic_equivalence=result_hash_variant==result_hash_original regression_tests=all_existing_pass performance_delta=measured_above_threshold resource_constraints=RSS_CPU_within_limits auto_accept=semantic_equivalence AND regression_tests AND performance_delta AND resource_constraints}

.g{observe=profile_hotspots_and_dependencies classify=workload_type_assessment discover=candidate_languages_from_profile generate=parallel_variant_creation verify=each_variant_semantically benchmark=each_variant_controlled rank=evidence_based_ranking decide=KEEP_or_MIGRATE_or_HYBRID}

.f{auto_accept_without_evidence migrate_without_profiling change_nucleus_without_approval rewrite_core_freely skip_semantic_verification assume_migration_is_better test_single_hypothesis_without_parallel_exploration exclude_baseline_from_comparison}

.w{
SELF_OPTIMIZE_V2=observe→classify→discover→generate→verify→benchmark→rank→decide
phase_1_screening=cheap_knowledge_based_candidate_selection
phase_2_proof=empirical_generate_verify_benchmark
class_A=micro_optimizations_mechanical→automatable
class_B=semantic_equivalent_refactors→generate+verify+benchmark
class_C=architectural_changes→propose+test+require_approval
unknown_language→discover→probe→model→generate→verify→benchmark→profile→remember
knowledge_gap→UNKNOWN_fitness→schedule_discovery→reduce_uncertainty
fitness_update=new_evidence→update_fitness→refine_conditional_rules
}

.x{
1=OBSERVE { analyze_codebase AST effects dependencies runtime_traces hotspots }
2=CLASSIFY { workload_type regex_heavy string_heavy CPU_bound graph_heavy numerical embedding }
3=DISCOVER { candidate_languages from LANGUAGE_KNOWLEDGE + workload_profile + past_benchmarks }
4=IDENTIFY_GAPS { unknown_fitness_for_relevant_workloads → schedule_discovery }
5=SCREEN { rank_candidates by_expected_fitness select_top_3_to_5 }
6=GENERATE { parallel_variant_creation for_each_candidate same_workload same_oracle same_semantics }
7=VERIFY { semantic_equivalence=result_hash_match for_each_variant }
8=BENCHMARK { controlled_measurement wall_clock RSS CPU for_each_variant }
9=RANK { sort_by_evidence semantic_pass first then performance_delta }
10=DECIDE { KEEP if baseline_wins or no_improvement_above_threshold MIGRATE if_clear_winner HYBRID if_different_modules_benefit_different_languages }
11=UPDATE_KNOWLEDGE { fitness_update provenance record knowledge_gap_reduction }
}

.p{
  arch=spec/LIN_CORE_ARCH.rulel
  ir_cross=spec/LIN_IR_CROSS_BACKEND.rulel
  bench=spec/LIN_EMIT_BENCHMARK.rulel
  autonomy=spec/LIA_AUTONOMY.dicel
  b6=spec/B6_LOGIC_SPEC_V2.rulel
  b9=spec/B9_AGENT_REAL_SPEC_V1.rulel
  discovery=spec/LIN_LANGUAGE_DISCOVERY.rulel
}

.s{
  workload_profile={
    module_id: string,
    workload_types: [enum{regex_heavy, string_heavy, CPU_bound, graph_heavy, numerical, IO_bound, embedding, concurrency}],
    current_language: string,
    current_performance: { wall_clock: float, RSS: float },
    hotspot_functions: [string]
  }
}

.s{
  candidate_selection={
    workload_profile: workload_profile,
    candidate_scores: [{ language: string, expected_fitness: float, justification: string }],
    selected_candidates: [string],
    screening_method: enum{knowledge_based, historical_benchmark, language_profile}
  }
}

.s{
  comparison_record={
    module_id: string,
    variants: [{
      language: string,
      is_baseline: bool,
      semantic_equivalence: bool,
      regression_tests: bool,
      wall_clock: float,
      RSS: float,
      performance_delta_vs_baseline: float,
      decision: enum{KEEP, REJECT, DEFER}
    }],
    final_decision: enum{KEEP, MIGRATE, HYBRID},
    winning_language: string,
    evidence_summary: string
  }
}

.s{
  language_knowledge_entry={
    language: string,
    workload_fitness: {
      regex_heavy: enum{poor, medium, strong},
      string_heavy: enum{poor, medium, strong},
      CPU_bound: enum{poor, medium, strong},
      graph_heavy: enum{poor, medium, strong},
      numerical: enum{poor, medium, strong},
      embedding: enum{poor, medium, strong}
    },
    evidence_level: enum{OBSERVED, DOCUMENTED, VERIFIED},
    historical_benchmarks: [string]
  }
}

.s{
  example_comparison={
    module_id: "content_hash",
    variants: [
      { language: "MJS", is_baseline: true, semantic_equivalence: true, wall_clock: 8.26, decision: "KEEP" },
      { language: "Rust", is_baseline: false, semantic_equivalence: false, wall_clock: 110.89, decision: "REJECT" },
      { language: "Nim", is_baseline: false, semantic_equivalence: "?", wall_clock: "?", decision: "DEFER" }
    ],
    final_decision: "KEEP",
    winning_language: "MJS",
    evidence_summary: "MJS baseline wins. Rust semantic mismatch + performance regression."
  }
}
