@RULEL:KERNEL_CANDIDATE_NIM_01:1.0.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .x=steps .p=path .d=design_principle .s=score}
.m{lang=LIN status=SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=Nim_is_first_architecturally_competitive_candidate}
.d{P0=agent_native_first purpose=represent!infer!transform!verify}

.r{R_START=Nim_begins_as_UNKNOWN_for_string_workloads R_DISCOVERY=Nim_compiler_already_installed R_GENERATE=produce_Nim_variant_of_content_hash R_VERIFY=semantic_equivalence_must_pass_before_performance R_BENCHMARK=compare_against_known_baseline R_RECORD=update_lia_knowledge_with_full_provenance R_METHOD=semantic_fail_blocks_valid_ranking}

.c{
  starting_state="Nim = UNKNOWN for all workloads"
  environment="Nim 2.2.0 installed via choco"
  workload="string_heavy + regex_heavy"
  baseline="TypeScript (5.51 us per call)"
  target="content_hash module"
}

.g{
  discovery_gate=Nim_compiler_found_and_executable
  generate_gate=Nim_variant_produces_correct_output
  verify_gate=semantic_equivalence_confirmed
  benchmark_gate=performance_measurement_complete
  record_gate=knowledge_base_updated_with_provenance
}

.f{skip_semantic_verification declare_winner_without_evidence}

.w{
KERNEL_CANDIDATE_NIM_01=discover→generate→verify→benchmark→record
semantic_fail=performance_is_diagnostic_only_not_valid_ranking
semantic_pass=benchmark_is_valid_for_ranking
}

.x{
1=DISCOVER { verify_Nim_compiler_exists check_version confirm_executable }
2=GENERATE { write_Nim_variant_of_content_hash keeping_same_workload same_oracle same_semantics }
3=COMPILE { compile_Nim_variant_to_native_binary }
4=VERIFY { compute_result_hash compare_with_baseline confirm_semantic_equivalence }
5=BENCHMARK { measure_CPU_us measure_RAM measure_allocations run_1000_iterations }
6=RECORD { update_lia_knowledge.dicel add_Nim_fitness_entry add_provenance add_evidence }
}

.p{
  discovery=spec/LIN_LANGUAGE_DISCOVERY.rulel
  knowledge_v2=spec/LANGUAGE_KNOWLEDGE_V2.rulel
  self_optimize=spec/LIN_SELF_OPTIMIZE.rulel
  kernel_candidate=spec/KERNEL_CANDIDATE_V1.rulel
  knowledge=storage/lia_knowledge.dicel
}

.s{
  nim_evidence={
    candidate_source_hash: string,
    candidate_binary_hash: string,
    input_hash: string,
    expected_result_hash: string,
    actual_result_hash: string,
    semantic_equivalence: bool,
    performance_us: float,
    memory_bytes: int,
    allocations: int,
    interpretation: string
  }
}

.s{
  decision_protocol={
    semantic_pass: "benchmark is valid for ranking → compute fitness",
    semantic_fail: "performance is diagnostic only → reject for ranking"
  }
}
