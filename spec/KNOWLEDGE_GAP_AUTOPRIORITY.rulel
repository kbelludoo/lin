@RULEL:KNOWLEDGE_GAP_AUTOPRIORITY:1.0.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .x=steps .p=path .d=design_principle .s=score}
.m{lang=LIN status=SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=lin_must_decide_what_to_investigate_next}
.d{P0=agent_native_first purpose=represent!infer!transform!verify}

.r{R_GAP=knowledge_gaps_must_be_identified_and_scored R_PRIORITY=priorities_must_be_computable_from_knowledge R_ORACLE=independent_validation_required R_YIELD=information_gain_per_cost_must_be_measured R_AGENDA=lin_must_generate_own_experimental_agenda}

.c{
  scoring_dimensions=[
    "impact",
    "uncertainty",
    "expected_information_gain",
    "architectural_relevance"
  ]
  priority_formula="impact × uncertainty × expected_information_gain × architectural_relevance"
  validation_method="compare_system_ranking against independent_oracle"
}

.g{
  gaps_identified=knowledge_gaps_extracted_from_lia_knowledge
  priorities_computed=gaps_scored_and_ranked
  oracle_validated=independent_oracle_produces_ranking
  accuracy_measured=system_ranking_matches_oracle
}

.f{hardcode_next_experiment skip_validation measure_only_system_ranking}

.w{
KNOWLEDGE_GAP_AUTOPRIORITY=extract_gaps→score→rank→validate→measure
}

.x{
1=EXTRACT { extract knowledge gaps from lia_knowledge.dicel }
2=SCORE { compute priority score for each gap }
3=RANK { sort gaps by priority score }
4=VALIDATE { compare against independent oracle }
5=MEASURE { compute PRIORITY_ACCURACY and DISCOVERY_YIELD }
}

.p{
  knowledge=storage/lia_knowledge.dicel
  spec=spec/KNOWLEDGE_GAP_AUTOPRIORITY.rulel
}

.s{
  priority_score=enum{
    impact="potential value of resolving the gap",
    uncertainty="current confidence level (inverse)",
    expected_information_gain="how much new knowledge would be gained",
    architectural_relevance="relevance to LIN architecture goals"
  }
  validation_metrics=enum{
    priority_accuracy="fraction of top-k system matches oracle top-k",
    discovery_yield="knowledge_gained / experiment_cost"
  }
}
