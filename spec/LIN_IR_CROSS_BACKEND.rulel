@RULEL:LIN_IR_CROSS_BACKEND:1.0.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .x=steps .p=path .d=design_principle}
.m{lang=LIN status=SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=cross_backend_semantic_equivalence_before_performance}
.d{P0=agent_native_first purpose=represent!infer!transform!verify}

.r{R_HASH=LIN_IR_HASH_over_canonical_serialization_not_raw_JSON R_ORDER=correctness_before_performance R_INTERPRET=no_structural_claim_from_single_workload R_GATE=E11_requires_4_4_pass_on_E8_E9}

.c{canonical=JSON_parse!canonical_serialize!SHA256("LIN/IR/0.1\0"||bytes) identity=LIN_IR_HASH_is_deterministic_over_canonical_form whitespace_order_textual_keys_do_not_affect_hash}

.g{integrity=lin_ir_hash_rust==lin_ir_hash_nim==lin_ir_hash_expected rust_correct=rust_result_hash==expected_result_hash nim_correct=nim_result_hash==expected_result_hash equivalent=rust_correct AND nim_correct ALL_4=integrity AND rust_correct AND nim_correct AND equivalent}

.f{interpret_structural_claim_from_single_workload compare_performance_before_all_4_checks_pass skip_correctness_to_measure_overhead}

.w{E8=IR_integrity_plus_correctness E9=cross_backend_equivalence E11=overhead_measurement ONLY_after_E8_E9_all_4_pass}

.x{
1=parse_JSON_source
2=canonical_serialization
3=compute_LIN_IR_HASH=SHA256("LIN/IR/0.1\0"||canonical_bytes)
4=emit_Rust_IR
5=emit_Nim_IR
6=verify_lin_ir_hash_rust==LIN_IR_HASH
7=verify_lin_ir_hash_nim==LIN_IR_HASH
8=run_Rust_IR→rust_result_hash
9=run_Nim_IR→nim_result_hash
10=verify_rust_result_hash==expected_result_hash
11=verify_nim_result_hash==expected_result_hash
12=if_all_4_PASS→proceed_E11
}

.p{spec_emit=spec/LIN_EMIT_BENCHMARK.rulel arch=spec/LIN_CORE_ARCH.rulel bench=benchmarks/}

.s{case_record={
  case_id: string,
  lin_ir_hash_expected: string,
  lin_ir_hash_rust: string,
  lin_ir_hash_nim: string,
  rust_result_hash: string,
  nim_result_hash: string,
  expected_result_hash: string,
  checks: {
    integrity: bool,
    rust_correct: bool,
    nim_correct: bool,
    equivalent: bool
  }
}}

.s{interpretation={
  scenario_A: {rust:+5pct nim:+6pct} → IR_contract_cost_small_and_backend_independent SUPPORTS_H_LIN_04,
  scenario_C: {rust:+35pct nim:+7pct} → Nim_lower_overhead_in_this_protocol_and_workload NOT_structural_claim,
  structural_claim: requires_C04_C10_replication_controlling_parser_allocator_internal_structure
}}
