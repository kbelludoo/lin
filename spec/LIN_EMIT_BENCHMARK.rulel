@RULEL:LIN_EMIT_BENCHMARK:1.2.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .p=path .s=score}
.m{lang=LIN status=MEASURED repo="C:/Users/k/Documents/lia" now=prefer_ts runtime_winner=c host=win32 date=2026-08-15 suite=tests/target_quality.lin}
.r{R0=WRITE=LIN R_NOW=compile_prefer_ts R_GATE=real_nucleus_only R_INTEL=never_false R_FULL=compile_and_run R_RANK=only_after_7x_FULL R_FUTURE=measured_winner_not_CLI_default R_9R=failover_on_timeout_or_empty}
.c{correctness_first=all_7_FULL then=speed!size pick=measured_host_lang_not_stub_not_fiction FULL=compile_ok_AND_run_ok COMPILE_ONLY=not_done FAIL=fix_emitter_or_harness_not_a_rank_loss}
.g{now_default=ts nucleus=ts!js!py!go!rust!c!java required=ts!js!py!go!rust!java c_skip=ok_iff_gcc_absent_after_retry stub=EXPERIMENTAL_NOT_PASS bench_eligible=nucleus_with_real_toolchain_only quality_bench=scripts/lin_target_quality_bench.mjs rank_gate=allRowsFull}
.w{NOW=prefer_ts QUALITY=7x_FULL_compile_run RANK=median_wall_ms_then_bytes CLI_DEFAULT_STAYS_TS=clone_behavior_eq}
.f{stub_as_PASS auto_PASS_without_compile INTEL_stub_auto_PASS COMPILE_ONLY_as_done 20lang_fiction bench_on_stubs pick_from_INTEL_fiction gcc_absent_as_PASS mutate_nucleus Dicel_as_working_surface node_-e_windows_paths go_tool_compile_GO111MODULE_off rank_with_FAIL_rows winner_table_with_COMPILE_ONLY}
.a{code=.lin|.lia rules=.rulel emit_now=ts runtime_winner=c emit_gate=ts!js!py!go!rust!c!java stub_emit=cs!lua!elixir!crystal!kotlin!hcl!julia!scala!haskell!prolog!zig!nim!asm entry_main=src/emit_entry_main.lin}
.s{warmup=2 repeats=9 metric=median_wall_ms_of_run c=FULL,32.46ms,1798b,r1 rust=FULL,35.20ms,2270b,r2 go=FULL,35.46ms,3267b,r3 py=FULL,105.27ms,1736b,r4 ts=FULL,113.98ms,487b,r5 js=FULL,115.27ms,447b,r6 java=FULL,197.86ms,2579b,r7 winner=c note="CLI emit stays ts; c is runtime winner on this host"}
.p{gate_lin=src/clone_lin_full_repo_gate.lin entry_main=src/emit_entry_main.lin loop_spec=spec/LIN_CLONE_LIN_LOOP.rulel cli=bin/lin.mjs bench=scripts/lin_target_quality_bench.mjs}
