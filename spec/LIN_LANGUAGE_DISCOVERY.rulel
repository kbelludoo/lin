@RULEL:LIN_LANGUAGE_DISCOVERY:1.1.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .x=steps .p=path .d=design_principle .s=score}
.m{lang=LIN status=SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=discovery_starts_with_environment_scan_not_hardcoded_list}
.d{P0=agent_native_first purpose=represent!infer!transform!verify}

.r{R_DISCOVER=unknown_language_requires_empirical_discovery R_LEVELS=three_knowledge_levels_observed_documented_verified R_SAME=discovery_uses_same_protocol_for_all_languages R_EVIDENCE=profile_from_measurement_not_assumption R_CONTEXTUAL=fitness_is_contextual_to_workload_constraints_and_evidence R_PROVENANCE=knowledge_entry_must_carry_provenance_for_auditability R_CONDITIONAL=rules_are_conditional_on_workload_type_not_absolute R_ENVIRONMENT=scan_environment_before_assuming_candidates R_GENERIC=discovery_protocol_works_for_any_language_not_just_known_ones}

.c{
  discovered_property=empirically_observed_through_probing
  documented_property=obtained_from_spec_or_documentation
  verified_property=proven_by_test_or_formal_proof
  language_profile=persisted_in_knowledge_base_for_future_use
  environment_scan_sources=[PATH, winget, choco, scoop, apt, brew, asdf, mise, Docker, WSL]
}

.g{
  scan=environment_scanned_for_executables_and_tools
  discover=exists_compiler_or_interpreter AND can_execute_hello_world
  probe=hello_world AND arithmetic AND loops AND arrays AND maps AND functions AND recursion AND errors
  model=execution_model AND memory_model AND typing AND GC_or_ownership AND compilation AND interoperability
  benchmark=standardized_workload_and_measurement
  profile=language_capability_scores_from_empirical_data
}

.f{assume_semantics_from_examples claim_documented_without_testing skip_probe_phase use_unknown_language_in_production_without_verification skip_environment_scan assume_candidate_list_is_complete}

.w{
DISCOVERY_V1=scan→identify→probe→model→filter→generate→verify→benchmark→profile→remember
knowledge_levels=OBSERVED→DOCUMENTED→VERIFIED
self_optimize_extension=unknown_language→discover→profile→consider_for_migration
kernel_candidate_prerequisite=discovery_must_complete_before_KERNEL_CANDIDATE_starts
contextual_fitness=fitness_is_conditional_on_workload_type_NOT_absolute_property
}

.x{
1=SCAN { scan_PATH scan_package_managers scan_SDKs scan_compilers scan_interpreters scan_registries }
2=IDENTIFY { for_each_executable try_version try_hello_world classify_as_known_or_unknown }
3=PROBE { hello_world arithmetic loops arrays maps functions recursion errors }
4=MODEL { execution_model memory_model typing GC_or_ownership compilation interop }
5=FILTER { select_languages_with_relevant_capabilities for_workload_type }
6=GENERATE { produce_variant_in_language keeping_same_workload same_oracle same_semantics }
7=VERIFY { semantic_equivalence=result_hash_match regression_tests=all_pass }
8=BENCHMARK { controlled_measurement wall_clock RSS CPU throughput }
9=PROFILE { compute_capability_scores CPU AST symbolic embedding startup }
10=REMEMBER { persist_language_profile_to_knowledge_base record_evidence_level }
}

.p{
  self_optimize=spec/LIN_SELF_OPTIMIZE.rulel
  arch=spec/LIN_CORE_ARCH.rulel
  kernel_candidate=spec/KERNEL_CANDIDATE_V1.rulel
  autonomy=spec/LIA_AUTONOMY.dicel
  knowledge=storage/lia_knowledge.dicel
}

.s{
  environment_scan_result={
    scan_id: string,
    scan_timestamp: timestamp,
    scan_sources: [string],
    discovered_executables: [{
      path: string,
      executable_name: string,
      version: string,
      status: enum{KNOWN, UNKNOWN, UNSUITABLE},
      language_guess: string
    }],
    total_discovered: int,
    known_count: int,
    unknown_count: int
  }
}

.s{
  discovery_record={
    language_name: string,
    executable_found: bool,
    interpreter: bool,
    compiler: bool,
    probe_results: {
      hello_world: bool,
      arithmetic: bool,
      loops: bool,
      arrays: bool,
      maps: bool,
      functions: bool,
      recursion: bool,
      errors: bool
    },
    model: {
      execution_model: string,
      memory_model: string,
      typing: string,
      GC_or_ownership: string,
      compilation: string,
      interoperability: string
    },
    knowledge_level: enum{OBSERVED, DOCUMENTED, VERIFIED}
  }
}

.s{
  language_profile={
    language_name: string,
    capability_scores: {
      B1_CPU: enum{poor, medium, strong},
      B2_AST: enum{poor, medium, strong},
      B8_SYMBOLIC: enum{poor, medium, strong},
      startup: enum{poor, excellent},
      embedding: enum{poor, excellent}
    },
    evidence_level: enum{OBSERVED, DOCUMENTED, VERIFIED},
    last_verified: timestamp,
    uses_for_lin: [string]
  }
}

.s{
  workload_fitness_entry={
    language: string,
    workload_type: enum{string_heavy, regex_heavy, CPU_bound, graph_heavy, numerical, IO_bound, embedding, concurrency},
    fitness: enum{STRONG, MEDIUM, WEAK, REJECTED, UNKNOWN},
    evidence: [string],
    provenance: {
      module: string,
      workload_hash: string,
      environment: string,
      benchmark_run: string,
      confidence: string
    }
  }
}

.s{
  example_full_discovery_pipeline={
    step_1_scan: "PATH + choco + winget → found: rustc.exe, nim.exe, g++.exe, zig.exe, tsc.exe, lua.exe, python.exe, crystal.exe",
    step_2_identify: "lua.exe → UNKNOWN (probe needed), crystal.exe → UNKNOWN, others → KNOWN",
    step_3_probe: "lua.exe → interpreter, dynamic, GC; crystal.exe → compiled, static, GC",
    step_4_model: "lua → bytecode VM; crystal → native binary",
    step_5_filter: "exclude none (all can compile LIN-IR)",
    step_6_9: "generate → verify → benchmark → profile",
    step_10_remember: "update lia_knowledge.dicel with full provenance"
  }
}
