@RULEL:LIN_CLONE_LIN_LOOP:1.8.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .c=contract .x=steps .p=path .w=when}
.m{lang=LIN aka=lingua_ia_nativa status=ACTIVE repo="C:/Users/k/Documents/lia" supersedes=spec/LIA_CLONE_LIA_LOOP.dicel parent=spec/LIA_AUTONOMY.dicel oracle=semantic_hash_exact_like_P200 bench=spec/LIN_EMIT_BENCHMARK.rulel}
.r{R0=WRITE=LIN R1=clone→oracle_hash→rewrite_LIN→compile→hash+behavior_eq R2=skip_eq_fail R3=full_source_tree R4=IMPROVE_LIN_FROM_CLONE_mandatory R5=stay_on_PARTIAL R6=INTEL_never_false R7=stub_never_PASS R8=default_emit=ts R_FUTURE=bench_all_real_then_pick R_9R=failover_on_timeout_or_empty}
