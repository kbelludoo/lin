.a{code=.lin|.lia rules=.rulel|.md(RULEL) intel=INTEL_CLONE_LIN_<name>.rulel candidates=candidates/CLONE_* emit=ts!js!py!go!rust!c!java stub_emit=cs!lua!elixir!crystal!kotlin!hcl!julia!scala!haskell!prolog!zig!nim!asm}
