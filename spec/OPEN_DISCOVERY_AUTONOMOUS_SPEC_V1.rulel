@RULEL:OPEN_DISCOVERY_AUTONOMOUS_SPEC_V1:1.0.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .x=steps .p=path .d=design_principle}
.m{lang=LIN status=FROZEN_SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=autonomous_toolchain_discovery_and_knowledge_selection}
.d{P0=discovery_governance purpose=discover!profile!verify!learn!select!preserve_nucleus}

.r{
  R_AUTONOMOUS_PROBE=probe_host_environment_for_available_compilers_and_extract_abi
  R_EMIT_AND_VERIFY=emit_LIN_IR_candidate_and_enforce_exact_canonical_oracle_match
  R_KNOWLEDGE_FEEDBACK=persist_empirical_profile_to_inform_subsequent_autonomous_choices
  R_IMMUTABLE_BARRIER=immutable_nucleus_must_remain_strictly_unmodified_during_discovery
}

.c{
  discovery_manifest={
    discovered_toolchain: string,
    compiler_path: string,
    version: string,
    semantic_match: boolean,
    measured_speedup: float,
    knowledge_entry_hash: string,
    subsequent_selection_pass: boolean,
    nucleus_hash: string
  }
}

.g{
  GATE_DISCOVERY_INTEGRITY=toolchain_detected_and_executable
  GATE_EMISSION_AND_VERIFY=emitted_kernel_passes_semantic_oracle
  GATE_KNOWLEDGE_PERSISTENCE=knowledge_ledger_updated_and_persisted
  GATE_FUTURE_SELECTION=selector_picks_newly_discovered_backend_for_target_domain
  GATE_NUCLEUS_IMMUTABILITY=nucleus_hash_unmodified
  GATE_OPEN_DISCOVERY_OVERALL=GATE_DISCOVERY_INTEGRITY AND GATE_EMISSION_AND_VERIFY AND GATE_KNOWLEDGE_PERSISTENCE AND GATE_FUTURE_SELECTION AND GATE_NUCLEUS_IMMUTABILITY
}

.f{
  hardcode_language_roster_without_runtime_discovery
  promote_discovered_backend_without_semantic_oracle_verification
  modify_protected_nucleus_during_language_discovery
}

.w{
  OPEN_DISCOVERY_EVAL=evaluate_LIN_autonomous_language_discovery_and_knowledge_reuse
}

.x{
  1=load_OPEN_DISCOVERY_AUTONOMOUS_SPEC_V1
  2=execute_host_toolchain_discovery_probe
  3=synthesize_LIN_IR_candidate_emitter_for_discovered_toolchain
  4=compile_and_verify_semantic_equivalence_against_canonical_oracle
  5=benchmark_performance_and_persist_to_knowledge_ledger
  6=invoke_autonomous_backend_selector_on_new_workload_and_verify_selection
  7=audit_all_gates_and_persist_evidence_open_discovery.json
}

.p{
  spec_json=spec/OPEN_DISCOVERY_AUTONOMOUS_SPEC_V1.json
  orchestrator=scripts/run_open_discovery_cycle.mjs
  evidence=artifacts/evidence_open_discovery.json
}
