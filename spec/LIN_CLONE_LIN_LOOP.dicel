@DICEL:LIN_CLONE_LIN_LOOP:1.5.0
^lang="LIN"
^aka="lingua_ia_nativa"
^repo="C:/Users/k/Documents/lia"
^lab="C:/Users/k/Documents/dicel-unified"
^status="ACTIVE"
^supersedes="LIA_CLONE_LIA_LOOP.dicel"
^parent="LIA_AUTONOMY.dicel"
^learn="AIL_LEARN_LOOP.dicel"
^oracle="semantic_hash_exact_like_P200"
^no_soft_match=true
^no_padding=true
^fix_target="compiler_outside_nucleus"
^immutable_core="verifier!semantic_hash!behavior_eq_gate!LIN_gate_ge_Dicel!semantic_invariants"
^publish_gate="suite_rate==1.0_JS"
^multi_target="js!ts!py!go!rust"
^toolchain="ALWAYS_INSTALL_MISSING"
^ensure="scripts/ensure_toolchains.mjs"

@GOAL {
  pipeline: "clone→oracle→rewrite_LIN→compile→hash→IMPROVE_LIN_FROM_CLONE→publish_ONLY_if_100%_else_stay→cleanup"
  publish_name: "clone-lin | clone-lin-<name>"
  results: "INTEL_CLONE_LIN_*.dicel comparison stays in lin/lia repo only"
  continuous: "until_queue_complete (default no wrap) | --repeat wrap | --stop-file | Ctrl+C"
  sticky_repo: "NEVER advance queue on PARTIAL; stay learn→fix→retry until 100%"
  wrap: "FORBIDDEN unless --repeat; when all queued DONE 100% EXIT success"
}

@QUEUE {
  source: "scripts/fetch_star_queue.mjs → storage/lin_year_star_queue.json"
  langs: [javascript, typescript, python, go, rust]
  pick: "created>=YEAR-01-01 most_stars per lang (gh search)"
  refresh: "--refresh-stars"
  rule: "finish_one_at_100%_THEN_next; if_all_DONE_EXIT; wrap_only_if_--repeat"
  new_lang: "python|go|rust → learn extract+emit; do not skip queue"
}

@STAGES {
  S1_CLONE {
    action: "git_clone famous_repo_with_tests → os.tmpdir/lin_clone_*"
  }
  S2_ORACLE {
    action: "exact sha256 String(outputs); soft_match FORBIDDEN"
    like: "P200"
  }
  S3_REWRITE {
    action: "emit API surface → .lin|.lia (WRITE=LIN; dual-read @LIN|@LIA|@AIL)"
  }
  S4_COMPILE_VERIFY {
    pass_iff: "behavior_eq==1.0 AND hash_match AND suite_rate==1.0"
    suite_rate: "pass/(pass+fail+skip); skip_counts_against_100%"
    gate_js: "behavior_eq+semantic_hash 1.0 REQUIRED to publish"
    other_targets: "ensure_toolchains THEN emit+run; SKIP_run only if install failed after retry (honest)"
    record: "per_target PASS|SKIP|FAIL; no_fake_100; no_padding"
  }
  S5_IMPROVE_LIN_FROM_CLONE {
    mandatory: true
    when: "ALWAYS after rewrite+verify (pass OR fail OR partial)"
    action: "read full rewrite+comparison+failures; mine emit/docs/trauma→rules/examples"
    allow: "candidates/ + Hypothesis + peripheral emitter fixes"
    forbid: "mutate_nucleus; edit_LIN_to_appease_emitter; soft_match"
    ledger: "kind=improve_lin_from_clone harvest=..."
  }
  S6_PASS_PUBLISH {
    only_when: "suite_rate==1.0 AND pass>0 AND fail==0 AND skip==0"
    gh_contents: "LIN .lin + RULEL README/manifest ONLY"
    forbid_in_gh: ".cjs!.js!.ts!.py!.go!.rs!compiled/"
    intel: "INTEL_CLONE_LIN_<name>.dicel stays in lia (hash/behavior_eq comparison)"
    compile_back: "lin compile lin/<fn>.lin --target js|ts|py|go|rust restores original"
    action: "gh push clone-lin-<name>; mark DONE; advance queue"
  }
  S7_PARTIAL_OR_FAIL {
    action: "INTEL+learn+improve; NO publish; NO queue advance; FIX compiler outside nucleus; retry SAME repo"
    forbid: "publish_partial; claim_done; skip_to_next_on_partial"
  }
  S8_CLEANUP {
    action: "ALWAYS rm temp original clone; verify path_absent"
  }
}

@CLI {
  run: "lin clone-lin [--repeat] [--cycles N] [--stop-file path] [--source url] [--name slug] [--queue-index N]"
  alias: "lia clone-lin | npm run clone-lin"
  script: "scripts/clone_lin_loop.mjs"
  stop: "all_queued_DONE_100% (default EXIT) OR Ctrl+C OR stop-file"
  default_wrap: false
  repeat: "--repeat enables wrap after last queued repo"
}

@ARTIFACTS {
  intel: "INTEL_CLONE_LIN_<name>.dicel"
  storage: "storage/lia_{ledger,trauma,hypotheses}.dicel"
  candidates: "candidates/CLONE_*"
  publish: "github.com/<user>/clone-lin-<name>"
  queue_state: ".clone_lin_queue_state.json"
}

@MULTI_TARGET {
  source: "LIN .lin|@LIN:"
  compile: "lin|lia compile --target js|ts|py|go|rust"
  publish_layout: "lin/*.lin + README.md(@RULEL compile_back)"
  include: "LIN sources that PASS JS gate; no host dumps"
  js_only_cjs: FORBIDDEN
  compiled_in_gh: FORBIDDEN
  skip_run: "ONLY after ensure_toolchains install+retry fail; emit kept; record OBSERVED+cmd_for_user"
}

@LEARN_NEW_LANG {
  when: "target_new OR emit_fail OR run_fail (non-js)"
  action: "Hypothesis + trauma + candidates/CLONE_* harvest"
  fix: "peripheral emit_ts|emit_py|emit_go|emit_rust|emit_shared; retry once"
  forbid: "mutate_nucleus; one_file_hardcode; edit_LIN_to_appease_emitter"
  transfer: "same_class next clone, not per-repo patch"
}

@HONESTY {
  prior_gaps: ["CLOSURE", "template_literal", "TS holdout 36.6%"]
  forbid: "fake_green; claim_full_suite without exact hash; publish_on_partial; advance_queue_on_partial; pad_multi_target"
}

@NINEROUTER {
  ^R_9R: "failover_on_timeout_or_empty; try_next_model; never_block_on_one"
  note: "any_9router_self_repair_or_LLM_patch_MUST_use_multi_model_failover"
  never_log: "NINEROUTER_KEY"
}
