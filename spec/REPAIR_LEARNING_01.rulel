@RULEL:REPAIR_LEARNING_01:1.0.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .x=steps .p=path .d=design_principle .s=score}
.m{lang=LIN status=SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=repair_strategy_learning_must_be_reusable}
.d{P0=agent_native_first purpose=represent!infer!transform!verify}

.r{R_LEARN=repair_history_must_inform_future_repairs R_PROVENANCE=learning_must_carry_provenance R_SELECT=strategy_selection_uses_success_rate R_VALIDATE=reuse_must_be_empirically_validated}

.c{
  source_language="Crystal (REJECTED_AFTER_BUDGET for hashing_algorithm)"
  target_language="Python (UNKNOWN for hashing_algorithm)"
  workload="string_heavy + regex_heavy"
  module="content_hash"
}

.g{
  learning_gate=repair_history_analyzed_for_strategy_patterns
  selection_gate=strategy_selected_by_success_rate
  validation_gate=reuse_produces_semantic_match
}

.f{apply_repair_strategy_without_considering_history ignore_success_rates}

.w{
REPAIR_LEARNING_01=analyze_history→select_strategy→apply_to_new→verify→validate_learning
learning_must_be_reusable=strategy_from_one_language_must_help_another
learning_must_be_provenanced=success_rates_carry_environment_and_oracle_context
}

.x{
1=ANALYZE { review_Crystal_repair_chain identify_hashing_algorithm_mismatch }
2=EXTRACT { extract_repair_strategy_from_successful_repairs }
3=SELECT { choose_strategy_by_success_rate_for_hashing_algorithm }
4=APPLY { apply_selected_strategy_to_Python_variant }
5=VERIFY { compute_result_hash compare_with_baseline }
6=VALIDATE { confirm_learning_improved_repair_efficiency }
7=RECORD { update lia_knowledge.dicel with learning_evidence }
}

.p{
  semantic_repair=spec/SEMANTIC_REPAIR_LOOP.rulel
  kernel_candidate=spec/KERNEL_CANDIDATE_V1.rulel
  knowledge=storage/lia_knowledge.dicel
}

.s{
  learning_analysis={
    source_language: string,
    source_repair_chain: repair_chain,
    mismatch_class: mismatch_taxonomy,
    strategies_tried: [{
      strategy: string,
      success: bool,
      iterations_to_fix: int
    }],
    recommended_strategy: string,
    confidence: float,
    provenance: {
      environment_hash: string,
      oracle_version_hash: string,
      total_cases: int,
      success_count: int
    }
  }
}

.s{
  reuse_result={
    target_language: string,
    strategy_applied: string,
    source_of_strategy: string,
    initial_result_hash: string,
    expected_result_hash: string,
    final_result_hash: string,
    iterations_used: int,
    semantic_match: bool,
    improvement_vs_baseline: float
  }
}
