@RULEL:BLIND_TOOLCHAIN_SYNTHESIS_SPEC_V1:1.0.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .x=steps .p=path .d=design_principle}
.m{lang=LIN status=FROZEN_SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=blind_toolchain_introspection_and_template_free_synthesis}
.d{P0=blind_synthesis purpose=probe_binary!infer_semantics!emit_dynamically!verify_oracle!preserve_nucleus}

.r{
  R_BLIND_INTROSPECTION=introspect_binary_cli_interface_without_preconfigured_templates
  R_DYNAMIC_EMIT=synthesize_executable_payload_from_LIN_IR_structural_ast
  R_ORACLE_GOVERNANCE=enforce_exact_oracle_checksum_equality_as_admission_gate
  R_NUCLEUS_IMMUTABILITY=protect_core_verifier_and_hash_definitions_unconditionally
}

.c{
  blind_synthesis_manifest={
    target_binary: string,
    inferred_execution_model: string,
    emitted_payload_hash: string,
    oracle_checksum_match: boolean,
    execution_duration_ms: float,
    nucleus_hash: string
  }
}

.g{
  GATE_BLIND_INTROSPECTION=binary_introspected_successfully
  GATE_DYNAMIC_VERIFY=dynamic_kernel_matches_oracle_identically
  GATE_KNOWLEDGE_INGEST=profile_ingested_into_knowledge_ledger
  GATE_NUCLEUS_IMMUTABILITY=nucleus_hash_unmodified
  GATE_BLIND_SYNTHESIS_OVERALL=GATE_BLIND_INTROSPECTION AND GATE_DYNAMIC_VERIFY AND GATE_KNOWLEDGE_INGEST AND GATE_NUCLEUS_IMMUTABILITY
}

.f{
  rely_on_hardcoded_source_code_templates_without_dynamic_generation
  bypass_canonical_oracle_verification_for_discovered_binaries
  modify_protected_nucleus_during_introspection
}

.w{
  BLIND_SYNTHESIS_EVAL=evaluate_LIN_template_free_toolchain_synthesis
}

.x{
  1=load_BLIND_TOOLCHAIN_SYNTHESIS_SPEC_V1
  2=introspect_generic_host_binary_interface
  3=synthesize_dynamic_LIN_IR_execution_payload
  4=execute_payload_and_verify_exact_match_against_canonical_oracle
  5=profile_latency_and_ingest_knowledge_into_toolchain_knowledge_base
  6=audit_all_gates_and_persist_evidence_blind_toolchain_synthesis.json
}

.p{
  spec_json=spec/BLIND_TOOLCHAIN_SYNTHESIS_SPEC_V1.json
  orchestrator=scripts/run_blind_toolchain_synthesis.mjs
  evidence=artifacts/evidence_blind_toolchain_synthesis.json
}
