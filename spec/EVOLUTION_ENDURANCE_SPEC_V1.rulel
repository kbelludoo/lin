@RULEL:EVOLUTION_ENDURANCE_SPEC_V1:1.0.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .x=steps .p=path .d=design_principle}
.m{lang=LIN status=FROZEN_SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=compositional_stability_and_multi_generation_self_optimization}
.d{P0=compositional_stability purpose=evolve!verify!rollback!preserve_invariants}

.r{
  R_ZERO_DRIFT=enforce_exact_bit_level_semantic_equality_with_canonical_oracle_on_all_generations
  R_CUMULATIVE_REGRESSION=every_promoted_generation_must_pass_the_entire_prior_gate_matrix
  R_NUCLEUS_IMMUTABILITY=never_mutate_core_verifier_and_semantic_hash_definitions_across_generations
  R_SAFE_ROLLBACK=automatically_reject_and_rollback_any_candidate_introducing_regression
}

.c{
  generation_manifest={
    generation_id: string,
    parent_generation_hash: string,
    candidate_hash: string,
    oracle_hash: string,
    semantic_result_hash: string,
    nucleus_hash: string,
    decision: string
  }
}

.g{
  GATE_ZERO_DRIFT=oracle_equivalence_passed_all_generations
  GATE_CUMULATIVE_REGRESSION=full_prior_regression_suite_passed_all_generations
  GATE_NUCLEUS_INVARIANCE=nucleus_hash_unmodified_across_all_generations
  GATE_NON_REGRESSIVE_PERFORMANCE=all_promoted_generations_ge_performance_floor
  GATE_ROLLBACK_VERIFICATION=fault_candidate_rejected_and_state_restored_cleanly
  GATE_ENDURANCE_OVERALL=GATE_ZERO_DRIFT AND GATE_CUMULATIVE_REGRESSION AND GATE_NUCLEUS_INVARIANCE AND GATE_NON_REGRESSIVE_PERFORMANCE AND GATE_ROLLBACK_VERIFICATION
}

.f{
  accumulate_semantic_drift_across_generations
  tolerate_regression_in_any_prior_gate
  promote_candidate_without_full_regression_audit
  modify_protected_nucleus_during_evolution
}

.w{
  EVOLUTION_ENDURANCE_EVAL=evaluate_LIN_multi_generation_reflexive_evolution
}

.x{
  1=load_EVOLUTION_ENDURANCE_SPEC_V1
  2=initialize_generation_G0_baseline_state_and_manifest
  3=execute_frozen_generations_G1_to_G5_with_reflexive_mediator
  4=inject_G4_FAULT_and_verify_automatic_rejection_and_clean_rollback
  5=audit_GATE_ZERO_DRIFT_and_GATE_CUMULATIVE_REGRESSION
  6=verify_GATE_NUCLEUS_INVARIANCE_across_all_generations
  7=persist_evidence_evolution_endurance.json
}

.p{
  spec_json=spec/EVOLUTION_ENDURANCE_SPEC_V1.json
  orchestrator=scripts/run_evolution_endurance.mjs
  evidence=artifacts/evidence_evolution_endurance.json
}
