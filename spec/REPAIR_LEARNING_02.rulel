@RULEL:REPAIR_LEARNING_02:1.0.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .x=steps .p=path .d=design_principle .s=score}
.m{lang=LIN status=SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=language_independent_repair_knowledge}
.d{P0=agent_native_first purpose=represent!infer!transform!verify}

.r{R_LEARN=repair_strategy_must_be_language_independent R_PROVENANCE=each_reuse_carries_provenance R_VALIDATE=multi_target_success_demonstrates_portability R_GENERALIZE=single_pair_is_not_universality}

.c{
  source_language="Crystal (hashing_algorithm mismatch)"
  target_languages=[Python, TypeScript, Rust]
  workload="string_heavy + regex_heavy"
  module="content_hash"
  strategy="implement SHA-256 canonicalization matching MJS algorithm"
}

.g{
  learning_gate=repair_history_analyzed_for_language_independent_patterns
  selection_gate=strategy_selected_by_success_rate
  validation_gate=multi_target_success_demonstrates_portability
}

.f{assume_single_pair_is_universality apply_strategy_without_adapting_to_target_language}

.w{
REPAIR_LEARNING_02=analyze_source→select_strategy→apply_to_targets→verify_all→validate_language_independence
language_independent_knowledge=strategy_works_across_multiple_targets
single_pair_is_not_universality=require_multiple_targets_for_portability_claim
}

.x{
1=ANALYZE { review_Crystal_repair_chain extract_SHA256_canonicalization_strategy }
2=SELECT { choose_strategy_by_success_rate_for_hashing_algorithm }
3=APPLY_PYTHON { apply_strategy_to_Python_variant }
4=APPLY_TYPESCRIPT { apply_strategy_to_TypeScript_variant }
5=APPLY_RUST { apply_strategy_to_Rust_variant }
6=VERIFY_ALL { compute_result_hashes compare_with_baseline }
7=VALIDATE { confirm_language_independence }
8=RECORD { update lia_knowledge.dicel with multi_target_evidence }
}

.p{
  semantic_repair=spec/SEMANTIC_REPAIR_LOOP.rulel
  repair_learning_01=spec/REPAIR_LEARNING_01.rulel
  kernel_candidate=spec/KERNEL_CANDIDATE_V1.rulel
  knowledge=storage/lia_knowledge.dicel
}

.s{
  multi_target_result={
    source_language: string,
    strategy: string,
    targets: [{
      language: string,
      initial_result_hash: string,
      expected_result_hash: string,
      final_result_hash: string,
      semantic_match: bool,
      iterations_used: int,
      adaptation_required: bool
    }],
    portability_score: float,
    language_independence: bool
  }
}

.s{
  portability_score={
    definition: "percentage of targets where strategy produced semantic match without adaptation",
    formula: "successful_targets / total_targets",
    interpretation: {
      1.0: "fully language-independent",
      0.67: "partially language-independent",
      0.33: "limited portability",
      0.0: "not portable"
    }
  }
}
