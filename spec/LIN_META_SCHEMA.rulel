@RULEL:LIN_META_SCHEMA:1.0.0
~R{.m=meta .r=rule .f=forbid .c=contract .p=path .s=schema}
.m{name=LIN_META_SCHEMA lang=LIN status=FROZEN repo="C:/Users/k/Documents/lia" date=2026-08-15 purpose=define_4_layer_linmeta_structure}

.s{
  layer1_identity=".linmeta/identity/semantic_registry.dicel"
  layer2_rules=".linmeta/rules/invariants.rulel"
  layer3_history=".linmeta/history/decision_log.ledger"
  layer4_graph=".linmeta/graph/module_refs.dicel"
}

.c{
  semantic_registry={symbol_id:string, module_ref:string, signature:string, effects:string, capabilities:string, semantic_hash:string}
  invariants={rule_id:string, condition:string, severity:string, repair_action:string}
  decision_log={decision_id:string, reason:string, affected_modules:string, approval_state:string}
  module_refs={source:string, dependency:string, dependency_hash:string}
}

.f{
  mix_identity_and_history_in_same_file
  mutate_linmeta_without_updating_semantic_hash
  delete_invariants_during_amnesia_recovery
}

.p{
  dir=".linmeta"
  generator="scripts/build_linmeta.mjs"
}
