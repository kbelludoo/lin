@RULEL:KERNEL_CANDIDATE_V1:1.3.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .x=steps .p=path .s=score .d=design_principle}
.m{lang=LIN status=SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=semantic_repair_loop_enables_active_correction}
.d{P0=agent_native_first purpose=represent!infer!transform!verify}
.d{IR_STABILITY=LIN_IR_is_the_stable_unit backend_is_interchangeable semantic_contract_is_verified_not_assumed}

.r{R_SAME=all_backends_receive_same_LIN_IR R_SEMANTIC=semantic_equivalence_required_before_performance R_EXHAUSTIVE=benchmark_all_discovered_candidates R_HONEST=no_winner_declared_until_evidence R_MULTI=multi_backend_architecture_may_be_optimal R_COMPONENT=matrix_is_component_x_backend_not_global_ranking R_MARGIN=single_winner_requires_meaningful_margin_not_fluctuation R_DISCOVERY=language_discovery_is_prerequisite_not_optional R_ENVIRONMENT=scan_environment_for_available_tools R_GENERIC=candidate_list_must_not_be_hardcoded R_REPAIR=mismatch_enters_semantic_repair_loop R_BUDGET=repair_has_limited_iterations_and_time R_ORACLE=oracle_and_contract_are_immutable R_CANDIDATE=only_candidate_implementation_may_change}

.c{
  semantic_equivalence=backend_result_hash==expected_result_hash
  components=[Inference, AST_Transform, IR_HashCons, State_Runtime, String_Tooling, Numeric_Kernel]
  metrics=[CPU, RAM, allocations, p99_latency, concurrency, cold_start, binary_size, build_time]
  minimum_margin=0.10
  max_repair_iterations=3
  max_repair_time_seconds=60
  oracle_immutable="oracle, schema, expected_result, semantic_contract cannot be modified"
  candidate_mutable="only candidate implementation may be changed"
}

.g{
  discovery_gate=environment_scanned_and_language_profiles_built
  semantic_gate=all_discovered_backends_produce_identical_result_hashes
  repair_gate=mismatch_enters_repair_loop_with_budget
  performance_gate=measure_all_metrics_after_semantic_pass
  component_gate=matrix_produced_for_each_component_x_backend
  margin_gate=single_winner_requires_10pct_advantage_minimum
  decision_gate=evidence_based_ranking_with_no_prior_belief
}

.f{declare_winner_before_benchmark assume_single_best_language skip_semantic_verification rank_by_opinion declare_winner_with_less_than_10pct_margin skip_discovery_phase assume_candidate_list_is_complete modify_oracle_to_make_hash_match}

.w{
KERNEL_CANDIDATE_V1=discover→identify→profile→filter→emit→compile→verify→repair→benchmark_matrix→rank→decide→remember
discovery_is_prerequisite=KERNEL_CANDIDATE_cannot_start_without_discovery
semantic_repair_loop=mismatch→diagnose→classify→repair→verify
termination_states=[INITIAL_PASS, REPAIRED_AND_VERIFIED, REJECTED_AFTER_BUDGET, DIAGNOSTIC_ONLY]
}

.x{
1=DISCOVER { scan_PATH scan_package_managers scan_SDKs scan_compilers scan_interpreters }
2=IDENTIFY { for_each_executable run_probes determine_language_and_version }
3=PROFILE { build_language_profile capability_scores evidence_level }
4=FILTER { select_candidates_with_relevant_capabilities exclude_known_unsuitable }
5=EMIT { LIN_IR → all_filtered candidate backends }
6=COMPILE { compile each backend to native/binary }
7=VERIFY { semantic_equivalence=hash_match for each backend }
8=REPAIR { if mismatch: enter semantic_repair_loop with budget }
9=BENCHMARK_MATRIX { for_each component × backend: CPU RAM allocations p99 cold_start binary_size build_time }
10=RANK_COMPONENT { for each component: rank backends by evidence }
11=RANK_GLOBAL { aggregate component rankings into global view }
12=DECIDE { single_winner (if 10pct+ margin) OR multi_backend OR workload_specific OR no_difference }
13=RECORD { update lia_knowledge.dicel with component_matrix and provenance }
}

.p{
  arch=spec/LIN_CORE_ARCH.rulel
  self_optimize=spec/LIN_SELF_OPTIMIZE.rulel
  ir_cross=spec/LIN_IR_CROSS_BACKEND.rulel
  discovery=spec/LIN_LANGUAGE_DISCOVERY.rulel
  repair=spec/SEMANTIC_REPAIR_LOOP.rulel
  knowledge=storage/lia_knowledge.dicel
}

.s{
  environment_scan_result={
    scan_sources: [PATH, winget, choco, scoop, apt, brew, asdf, mise, Docker, WSL],
    discovered_executables: [{
      path: string,
      name: string,
      version: string,
      language: string,
      status: enum{KNOWN, UNKNOWN, UNSUITABLE}
    }]
  }
}

.s{
  component_backend_matrix={
    component: enum{Inference, AST_Transform, IR_HashCons, State_Runtime, String_Tooling, Numeric_Kernel},
    backend_results: [{
      backend: string,
      semantic_equivalence: bool,
      termination_state: enum{INITIAL_PASS, REPAIRED_AND_VERIFIED, REJECTED_AFTER_BUDGET, DIAGNOSTIC_ONLY},
      repair_attempts: int,
      CPU_us: float,
      RAM_bytes: int,
      allocations: int,
      p99_latency_us: float,
      cold_start_ms: float,
      binary_size_bytes: int,
      build_time_ms: float,
      rank_for_component: int
    }]
  }
}

.s{
  single_winner_criteria={
    semantic_equivalence: "PASS for all backends",
    no_critical_regression: "no metric regresses >20% vs any other backend",
    minimum_margin: ">=10% advantage in primary metrics (CPU, RAM)",
    consistency: "wins majority of components"
  }
}

.s{
  possible_decisions={
    single_winner: "one backend clearly superior across all metrics with 10pct+ margin",
    multi_backend: "different backends optimal for different kernel components",
    workload_specific: "ranking changes based on kernel workload type",
    no_difference: "all backends statistically equivalent → choose by other factors"
  }
}

.s{
  example_repair_flow={
    step_7_verify: {result: "MISMATCH", initial_hash: "abc123", expected_hash: "def456"},
    step_8_repair_attempt_1: {diagnosis: "hashing_algorithm", repair: "implement_same_hash", result: "MISMATCH"},
    step_8_repair_attempt_2: {diagnosis: "whitespace_normalization", repair: "normalize_whitespace", result: "MATCH"},
    termination: "REPAIRED_AND_VERIFIED",
    benchmark_valid: true
  }
}

.s{
  example_exhausted_flow={
    step_7_verify: {result: "MISMATCH", initial_hash: "abc123", expected_hash: "def456"},
    step_8_repair_attempt_1: {diagnosis: "regex_semantics", repair: "fix_regex_groups", result: "MISMATCH"},
    step_8_repair_attempt_2: {diagnosis: "unicode_normalization", repair: "normalize_unicode", result: "MISMATCH"},
    step_8_repair_attempt_3: {diagnosis: "ordering", repair: "sort_keys", result: "MISMATCH"},
    termination: "REJECTED_AFTER_BUDGET",
    benchmark_valid: false
  }
}
