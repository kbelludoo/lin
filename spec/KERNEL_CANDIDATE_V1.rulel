@RULEL:KERNEL_CANDIDATE_V1:1.0.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .x=steps .p=path .s=score .d=design_principle}
.m{lang=LIN status=SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=no_proven_winner_for_kernel_emperical_benchmark_needed}
.d{P0=agent_native_first purpose=represent!infer!transform!verify}
.d{IR_STABILITY=LIN_IR_is_the_stable_unit backend_is_interchangeable semantic_contract_is_verified_not_assumed}

.r{R_SAME=all_backends_receive_same_LIN_IR R_SEMANTIC=semantic_equivalence_required_before_performance R_EXHAUSTIVE=benchmark_all_tier1_candidates R_HONEST=no_winner_declared_until_evidence R_MULTI=multi_backend_architecture_may_be_optimal}

.c{
  semantic_equivalence=backend_result_hash==expected_result_hash
  all_candidates=[Rust, Nim, Cplusplus, Zig, TypeScript, C]
  metrics=[CPU, RAM, allocations, p99_latency, concurrency, cold_start, binary_size, build_time]
  first_gate=semantic_equivalence_for_all
  second_gate=performance_across_all_metrics
}

.g{
  semantic_gate=all_backends_produce_identical_result_hashes
  performance_gate=measure_all_metrics_after_semantic_pass
  decision_gate=evidence_based_ranking_with_no_prior_belief
}

.f{declare_winner_before_benchmark assume_single_best_language skip_semantic_verification rank_by_opinion}

.w{
KERNEL_CANDIDATE_V1=emit_LIN_IR→compile_all→verify_semantics→benchmark_all→rank→decide
possible_outcomes=[single_winner, multi_backend_hybrid, workload_specific_ranking]
}

.x{
1=EMIT { LIN_IR → all_candidate backends }
2=COMPILE { compile each backend to native/binary }
3=VERIFY { semantic_equivalence=hash_match for each backend }
4=BENCHMARK { CPU RAM allocations p99 cold_start binary_size build_time for each }
5=RANK { sort by evidence across all metrics }
6=DECIDE { single_winner OR multi_backend_hybrid OR workload_specific }
7=RECORD { update lia_knowledge.dicel with provenance }
}

.p{
  arch=spec/LIN_CORE_ARCH.rulel
  self_optimize=spec/LIN_SELF_OPTIMIZE.rulel
  ir_cross=spec/LIN_IR_CROSS_BACKEND.rulel
  knowledge=storage/lia_knowledge.dicel
}

.s{
  kernel_candidate_result={
    backend: string,
    semantic_equivalence: bool,
    CPU_us: float,
    RAM_bytes: int,
    allocations: int,
    p99_latency_us: float,
    cold_start_ms: float,
    binary_size_bytes: int,
    build_time_ms: float,
    decision: enum{WINNER, STRONG_CANDIDATE, WEAK_CANDIDATE, REJECTED}
  }
}

.s{
  possible_decisions={
    single_winner: "one backend clearly superior across all metrics",
    multi_backend: "different backends optimal for different kernel components",
    workload_specific: "ranking changes based on kernel workload type",
    no_difference: "all backends statistically equivalent → choose by other factors"
  }
}

.s{
  example_multi_backend_architecture={
    LIN_Semantic_Core: {
      inference_engine: "Rust or OCaml",
      ast_transforms: "Nim or OCaml",
      string_tooling: "TypeScript",
      native_kernel: "C++ or Zig",
      logic_engine: "specialized_prolog_or_clp"
    }
  }
}
