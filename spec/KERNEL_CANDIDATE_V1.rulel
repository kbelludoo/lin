@RULEL:KERNEL_CANDIDATE_V1:1.1.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .x=steps .p=path .s=score .d=design_principle}
.m{lang=LIN status=SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=component_matrix_not_global_ranking}
.d{P0=agent_native_first purpose=represent!infer!transform!verify}
.d{IR_STABILITY=LIN_IR_is_the_stable_unit backend_is_interchangeable semantic_contract_is_verified_not_assumed}

.r{R_SAME=all_backends_receive_same_LIN_IR R_SEMANTIC=semantic_equivalence_required_before_performance R_EXHAUSTIVE=benchmark_all_tier1_candidates R_HONEST=no_winner_declared_until_evidence R_MULTI=multi_backend_architecture_may_be_optimal R_COMPONENT=matrix_is_component_x_backend_not_global_ranking R_MARGIN=single_winner_requires_meaningful_margin_not_fluctuation}

.c{
  semantic_equivalence=backend_result_hash==expected_result_hash
  all_candidates=[Rust, Nim, Cplusplus, Zig, TypeScript, C]
  components=[Inference, AST_Transform, IR_HashCons, State_Runtime, String_Tooling, Numeric_Kernel]
  metrics=[CPU, RAM, allocations, p99_latency, concurrency, cold_start, binary_size, build_time]
  minimum_margin=0.10
  first_gate=semantic_equivalence_for_all
  second_gate=performance_across_all_metrics
}

.g{
  semantic_gate=all_backends_produce_identical_result_hashes
  performance_gate=measure_all_metrics_after_semantic_pass
  component_gate=matrix_produced_for_each_component_x_backend
  margin_gate=single_winner_requires_10pct_advantage_minimum
  decision_gate=evidence_based_ranking_with_no_prior_belief
}

.f{declare_winner_before_benchmark assume_single_best_language skip_semantic_verification rank_by_opinion declare_winner_with_less_than_10pct_margin}

.w{
KERNEL_CANDIDATE_V1=emit_LIN_IR→compile_all→verify_semantics→benchmark_matrix→rank→decide
possible_outcomes=[single_winner, multi_backend_hybrid, workload_specific_ranking, no_difference]
}

.x{
1=EMIT { LIN_IR → all_candidate backends }
2=COMPILE { compile each backend to native/binary }
3=VERIFY { semantic_equivalence=hash_match for each backend }
4=BENCHMARK_MATRIX { for_each component × backend: CPU RAM allocations p99 cold_start binary_size build_time }
5=RANK_COMPONENT { for each component: rank backends by evidence }
6=RANK_GLOBAL { aggregate component rankings into global view }
7=DECIDE { single_winner (if 10pct+ margin) OR multi_backend OR workload_specific OR no_difference }
8=RECORD { update lia_knowledge.dicel with component_matrix and provenance }
}

.p{
  arch=spec/LIN_CORE_ARCH.rulel
  self_optimize=spec/LIN_SELF_OPTIMIZE.rulel
  ir_cross=spec/LIN_IR_CROSS_BACKEND.rulel
  knowledge=storage/lia_knowledge.dicel
}

.s{
  component_backend_matrix={
    component: enum{Inference, AST_Transform, IR_HashCons, State_Runtime, String_Tooling, Numeric_Kernel},
    backend_results: [{
      backend: string,
      semantic_equivalence: bool,
      CPU_us: float,
      RAM_bytes: int,
      allocations: int,
      p99_latency_us: float,
      cold_start_ms: float,
      binary_size_bytes: int,
      build_time_ms: float,
      rank_for_component: int
    }]
  }
}

.s{
  single_winner_criteria={
    semantic_equivalence: "PASS for all backends",
    no_critical_regression: "no metric regresses >20% vs any other backend",
    minimum_margin: ">=10% advantage in primary metrics (CPU, RAM)",
    consistency: "wins majority of components"
  }
}

.s{
  possible_decisions={
    single_winner: "one backend clearly superior across all metrics with 10pct+ margin",
    multi_backend: "different backends optimal for different kernel components",
    workload_specific: "ranking changes based on kernel workload type",
    no_difference: "all backends statistically equivalent → choose by other factors"
  }
}

.s{
  example_multi_backend_result={
    Inference: "Rust (CPU -30%, RAM -20%)",
    AST_Transform: "Nim (CPU -15%, build -40%)",
    IR_HashCons: "Rust (CPU -25%, RAM -30%)",
    State_Runtime: "Rust (concurrency +50%)",
    String_Tooling: "TypeScript (CPU -60%, semantic PASS)",
    Numeric_Kernel: "C++ (CPU -40%, native)"
  }
}

.s{
  example_matrix_visualization={
    headers: "              Rust    Nim     C++     Zig     TS      C",
    Inference: "           [ BEST  ] [       ] [       ] [       ] [       ] [       ]",
    AST_Transform: "       [       ] [ BEST  ] [       ] [       ] [       ] [       ]",
    IR_HashCons: "         [ BEST  ] [       ] [       ] [       ] [       ] [       ]",
    State_Runtime: "       [ BEST  ] [       ] [       ] [       ] [       ] [       ]",
    String_Tooling: "      [       ] [       ] [       ] [       ] [ BEST  ] [       ]",
    Numeric_Kernel: "      [       ] [       ] [ BEST  ] [       ] [       ] [       ]"
  }
}
