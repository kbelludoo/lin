REAL_AUTONOMOUS_ENGINEERING_V4_B {

    id: V4_B_FINDING_PRECISION
    version: 1.0.0
    status: ACTIVE
    protocol_frozen: true

    objective:
        finding_precision

    description: >
        Test whether the agent can distinguish real bugs from false positives
        in a blind analysis. The agent receives ONLY the source code — no
        issue tracker, no commit history, no test oracle, no CVE numbers.
        The key test is judgment: knowing when NOT to act.

    repository:
        name: axios
        version: v1.14.0
        url: https://github.com/axios/axios
        loc: ~5000 (lib/ source only)
        path: benchmarks/v4_b_axios

    hidden_dataset:
        known_bugs: >= 5
        false_candidates: >= 10
        bug_classes:
            - prototype_pollution
            - ssrf
            - header_injection
            - stream_bypass
            - deprecated_api
            - input_validation
            - resource_exhaustion

    constraints:
        no_issue_access: true
        no_commit_history: true
        no_test_oracle_during_analysis: true
        no_cve_numbers: true
        blind_analysis: true

    output_format:
        findings:
            - id: unique identifier
              file: source file path
              line: line number (approximate)
              category: bug class
              confidence: HIGH | MEDIUM | LOW
              description: what is wrong
              impact: SECURITY | CORRECTNESS | RELIABILITY | PERFORMANCE
              fix_sketch: how to fix (optional)
              status: FINDING_CONFIRMED | FALSE_POSITIVE_REJECTED | NEEDS_REVIEW

    metrics:
        precision: confirmed / (confirmed + false_positives_rejected)
        recall: confirmed / total_known_bugs (computed post-hoc)
        false_positive_rate: false_positives_rejected / total_findings
        escalation_rate: needs_review / total_findings
        high_impact_false_positives: count of HIGH confidence false positives

    acceptance_criteria:
        precision: >= 0.80
        false_positive_rate: <= 0.20
        high_impact_false_positives: = 0
        unsupported_fix_proposals: = 0

    execution_phases:
        V4_B_1:
            name: blind_analysis
            action: agent analyzes source code without any external context
            output: raw_findings.json

        V4_B_2:
            name: oracle_comparison
            action: compare findings against hidden oracle
            output: v4_b_evaluation.json

        V4_B_3:
            name: metric_computation
            action: compute precision, recall, FPR, escalation_rate
            output: v4_b_metrics.json
}
