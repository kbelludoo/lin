REAL_AUTONOMOUS_ENGINEERING_V4_C {

    id: V4_C_UNKNOWN_FLOW_GENERALIZATION
    version: 1.0.0
    status: ACTIVE
    protocol_frozen: true

    parent: V4_B1_COVERAGE_BALANCE

    objective: unknown_flow_generalization

    description: >
        V4-B.1 demonstrated that system-model-driven analysis achieves perfect
        recall and oracle precision on prototype pollution, SSRF, header injection,
        and resource exhaustion bugs in axios. The agent transitioned from pattern
        matching to model-based analysis.

        V4-C tests whether this model-based analysis GENERALIZES to vulnerability
        classes the agent has never seen. The target is path-to-regexp@6.3.0,
        which has a ReDoS vulnerability (CVE-2024-45296) — a completely different
        class from anything in V4-B.

        The question changes from:
            "Can it find bugs it was trained on?"
        to:
            "Can it find violations of properties it has never seen?"

    frozen_protocol:
        repository: "path-to-regexp@6.3.0"
        oracle: "benchmarks/v4_c_path_to_regexp/v4_c_oracle.json"
        vulnerability_classes: 1 (ReDoS)
        forbidden:
            - adding_redos_specific_rules
            - "procure ReDoS"
            - "procure backtracking"
            - any vulnerability-specific probe
            - telling the agent about CVE-2024-45296

    repository:
        name: path-to-regexp
        version: 6.3.0
        url: https://github.com/pillarjs/path-to-regexp
        loc: ~640 (src/index.ts only)
        path: benchmarks/v4_c_path_to_regexp
        description: "Turns path strings (like /user/:id) into regular expressions. Used by Express, React Router, etc."

    analysis_strategy:
        SAME_AS_V4_B1: true
        phases:
            PHASE_1:
                name: system_model_construction
                action: >
                    Build a model of the system. Identify:
                    - All sources (path strings, options, patterns)
                    - All sinks (regex output, matching functions)
                    - All transforms (parse → tokens → regex)
                    - All trust boundaries (where untrusted input crosses into regex generation)
                output: system_model.json
                metrics:
                    - flow_discovery_recall

            PHASE_2:
                name: probe_execution_on_graph
                action: >
                    For each discovered flow, apply probes:
                    - Does the flow cross a trust boundary?
                    - Are guards sufficient for the trust level?
                    - What is the missing guard?
                    - What is the potential impact?
                output: risk_candidates.json
                metrics:
                    - intervention_precision

            PHASE_3:
                name: intervention_decision
                action: >
                    For each risk candidate, decide:
                    - CONFIRMED: real bug with sufficient evidence
                    - FALSE_POSITIVE: pattern looks dangerous but is safe
                    - NEEDS_REVIEW: plausible but insufficient evidence
                output: findings.json
                metrics:
                    - precision
                    - recall
                    - false_positive_rate

    metrics:
        generalization_score:
            formula: "novel_bugs_found / total_novel_bugs"
            purpose: "Can the agent find vulnerability classes it has never seen?"
            v4_c_target: ">= 0.80"
        precision:
            formula: "confirmed / (confirmed + false_positives)"
            v4_c_target: ">= 0.80"
        recall:
            formula: "confirmed_oracle_bugs / total_oracle_bugs"
            v4_c_target: ">= 0.80"

    acceptance_criteria:
        generalization_score: ">= 0.80"
        precision: ">= 0.80"
        recall: ">= 0.80"
        false_positive_rate: "<= 0.20"

    diagnostic_interpretation:
        high_generalization: "Agent can find novel vulnerability classes — true model-based analysis"
        low_generalization: "Agent only finds patterns it has seen — pattern matching despite system model"
        high_precision_low_generalization: "Agent is conservative — avoids unknown risks"
        low_precision_high_generalization: "Agent explores broadly but misclassifies"
}
