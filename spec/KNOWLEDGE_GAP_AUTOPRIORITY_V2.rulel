@RULEL:KNOWLEDGE_GAP_AUTOPRIORITY_V2:1.0.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .x=steps .p=path .d=design_principle .s=score}
.m{lang=LIN status=SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=lin_must_learn_from_its_own_prioritization_mistakes}
.d{P0=agent_native_first purpose=represent!infer!transform!verify}

.r{R_LEARN=prioritizer_must_update_weights_from_feedback R_COMPARE=prediction_vs_outcome_must_be_measured R_ACCURACY=accuracy_must_improve_over_iterations R_LEARNING_RATE=learning_rate_must_be_quantified}

.c{
  initial_weights={impact: 0.25, uncertainty: 0.25, information_gain: 0.25, relevance: 0.25}
  learning_rate=0.1
  feedback_iterations=3
  validation_method="compare system_ranking against oracle after each iteration"
}

.g{
  weights_initialized=initial_weights_set
  experiment_executed=gap_experiment_completed
  feedback_collected=prediction_vs_outcome_measured
  weights_updated=prioritizer_weights_adjusted
  accuracy_improved=PRIORITY_ACCURACY_increased
}

.f{skip_weight_update use_fixed_weights ignore_feedback}

.w{
KNOWLEDGE_GAP_AUTOPRIORITY_V2=initialize→prioritize→execute→feedback→update→repeat
}

.x{
1=INITIALIZE { set initial weights for scoring dimensions }
2=PRIORITIZE { compute ranking using current weights }
3=EXECUTE { run highest-priority experiment }
4=FEEDBACK { compare predicted priority vs actual outcome }
5=UPDATE { adjust weights based on feedback }
6=REPEAT { re-prioritize with updated weights }
}

.p{
  knowledge=storage/lia_knowledge.dicel
  spec_v1=spec/KNOWLEDGE_GAP_AUTOPRIORITY.rulel
  spec_v2=spec/KNOWLEDGE_GAP_AUTOPRIORITY_V2.rulel
}

.s{
  learning_metrics=enum{
    priority_accuracy="fraction of top-k matches with oracle",
    priority_learning_rate="improvement in accuracy after weight update",
    weight_convergence="how much weights change between iterations",
    prediction_error="difference between predicted and actual priority"
  }
}
