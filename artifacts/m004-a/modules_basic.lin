@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=m004_a_namespaced_modules
~G{?=if #=for ^=ret :else}

mod MathOps {
  !add(a: int, b: int): int {
    ^a + b
  }
  !multiply(a: int, b: int): int {
    ^a * b
  }
}

use MathOps::{add, multiply};

!compute(x: int, y: int): int {
  sum = add(x, y);
  prod = multiply(x, y);
  ^sum + prod
}

!qualifiedCompute(x: int, y: int): int {
  ^MathOps::multiply(x, y)
}

=ex{compute,qualifiedCompute}
