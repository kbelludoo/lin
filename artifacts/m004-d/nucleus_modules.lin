@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=m004_d_nucleus_modularization
~G{?=if #=for ^=ret :else}

mod AstModule {
  enum NodeKind {
    Function,
    Module,
    Statement
  }

  struct SyntaxNode {
    kind: NodeKind,
    id: String,
    line: int
  }

  !createNode(kind: NodeKind, id: String, line: int): SyntaxNode {
    ^SyntaxNode { kind: kind, id: id, line: line }
  }
}

mod ParserModule {
  use AstModule::{NodeKind, SyntaxNode, createNode};

  !parseFunctionSignature(sig: String, line: int): SyntaxNode {
    ^createNode(NodeKind::Function, sig, line)
  }

  !parseModuleHeader(name: String, line: int): SyntaxNode {
    ^createNode(NodeKind::Module, name, line)
  }
}

mod SemanticModule {
  use AstModule::{NodeKind, SyntaxNode};

  !validateNode(node: SyntaxNode): bool {
    match(node) {
      SyntaxNode { kind: NodeKind::Function, id, line } if line > 0 => { ^true }
      SyntaxNode { kind: NodeKind::Module, id, line } if line > 0 => { ^true }
      _ => { ^false }
    }
  }
}

mod EmitterModule {
  use AstModule::{NodeKind, SyntaxNode};

  !emitRustDeclaration(node: SyntaxNode): String {
    match(node) {
      SyntaxNode { kind: NodeKind::Function, id, line: _ } => { ^"pub fn " + id + "() {}" }
      SyntaxNode { kind: NodeKind::Module, id, line: _ } => { ^"pub mod " + id + " {}" }
      _ => { ^"// unknown node" }
    }
  }
}

use AstModule::{NodeKind, SyntaxNode};
use ParserModule::{parseFunctionSignature, parseModuleHeader};
use SemanticModule::{validateNode};
use EmitterModule::{emitRustDeclaration};

!compilePipeline(fnName: String, line: int): String {
  node = parseFunctionSignature(fnName, line);
  valid = validateNode(node.clone());
  ?(valid == true) {
    ^emitRustDeclaration(node)
  }
  ^"ERROR_INVALID_NODE"
}

!compileModulePipeline(modName: String, line: int): String {
  node = parseModuleHeader(modName, line);
  valid = validateNode(node.clone());
  ?(valid == true) {
    ^emitRustDeclaration(node)
  }
  ^"ERROR_INVALID_NODE"
}

=ex{compilePipeline,compileModulePipeline}
