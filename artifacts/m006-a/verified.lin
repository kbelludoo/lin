@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=formal_semantic_core

!safeDiv(value: int, divisor: int{!=0}): int {
    return value / divisor;
}

!classify(n: int): int {
    match(n) {
        1 => ^10,
        2 => ^20,
        _ => ^0
    }
    return 0;
}

!runTests(): int {
    let a = safeDiv(10, 2);
    return a;
}
