@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=real_world_ast
~G{?=if #=for ^=ret :else}

enum TokenKind {
  Number,
  Plus,
  Minus,
  Star,
  Slash,
  LParen,
  RParen,
  Eof
}

struct Token {
  kind: TokenKind,
  value: int
}

enum ExprKind {
  NumLiteral,
  BinaryAdd,
  BinarySub,
  BinaryMul,
  BinaryDiv
}

struct Expr {
  kind: ExprKind,
  leftVal: int,
  rightVal: int
}

!createNumExpr(val: int): Expr {
  ^Expr { kind: ExprKind::NumLiteral, leftVal: val, rightVal: 0 }
}

!createBinExpr(kind: ExprKind, left: int, right: int): Expr {
  ^Expr { kind: kind, leftVal: left, rightVal: right }
}

=ex{createNumExpr,createBinExpr}
