@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=real_world_calculator_main
~G{?=if #=for ^=ret :else}

use "./ast.lin"::{TokenKind, Token, ExprKind, Expr, createNumExpr, createBinExpr};
use "./evaluator.lin"::{evaluateExpr, formatResult};

!runAdd(a: int, b: int): String {
  e = createBinExpr(ExprKind::BinaryAdd, a, b);
  res = evaluateExpr(e);
  ^formatResult(res)
}

!runMul(a: int, b: int): String {
  e = createBinExpr(ExprKind::BinaryMul, a, b);
  res = evaluateExpr(e);
  ^formatResult(res)
}

!runDiv(a: int, b: int): String {
  e = createBinExpr(ExprKind::BinaryDiv, a, b);
  res = evaluateExpr(e);
  ^formatResult(res)
}

!runSub(a: int, b: int): String {
  e = createBinExpr(ExprKind::BinarySub, a, b);
  res = evaluateExpr(e);
  ^formatResult(res)
}

=ex{runAdd,runMul,runDiv,runSub}
