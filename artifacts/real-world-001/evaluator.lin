@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=real_world_evaluator
~G{?=if #=for ^=ret :else}

use "./ast.lin"::{ExprKind, Expr};

!evaluateExpr(e: Expr): int {
  match(e) {
    Expr { kind: ExprKind::NumLiteral, leftVal, rightVal: _ } => { ^leftVal }
    Expr { kind: ExprKind::BinaryAdd, leftVal, rightVal } => { ^leftVal + rightVal }
    Expr { kind: ExprKind::BinarySub, leftVal, rightVal } => { ^leftVal - rightVal }
    Expr { kind: ExprKind::BinaryMul, leftVal, rightVal } => { ^leftVal * rightVal }
    Expr { kind: ExprKind::BinaryDiv, leftVal, rightVal } if rightVal != 0 => { ^leftVal / rightVal }
    _ => { ^-1 }
  }
}

!formatResult(res: int): String {
  ?(res >= 0) {
    ^"RESULT:" + res
  }
  ^"ERROR:DIV_BY_ZERO"
}

=ex{evaluateExpr,formatResult}
