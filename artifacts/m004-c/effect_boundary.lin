@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=m004_c_effects_modules
~G{?=if #=for ^=ret :else}

mod Storage ~effects{io, state} {
  !readEntry(key: String): String {
    ^"ENTRY:" + key
  }

  !writeEntry(key: String, value: String): String {
    ^"STORED:" + key + "=" + value
  }
}

use Storage::{readEntry, writeEntry} ~caps{io, state};

!queryData(key: String): String {
  ^readEntry(key)
}

!saveData(key: String, value: String): String {
  ^writeEntry(key, value)
}

=ex{queryData,saveData}
