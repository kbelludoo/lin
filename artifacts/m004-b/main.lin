@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=m004_b_interfile_import
~G{?=if #=for ^=ret :else}

use "./math_helper.lin"::{square, cube};

!calculatePowerSum(x: int): int {
  sq = square(x);
  cb = cube(x);
  ^sq + cb
}

!qualifiedSquare(x: int): int {
  ^math_helper::square(x)
}

=ex{calculatePowerSum,qualifiedSquare}
