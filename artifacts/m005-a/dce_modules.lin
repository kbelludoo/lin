@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=m005_a_dce
~G{?=if #=for ^=ret :else}

mod ActiveMath {
  !usedAdd(a: int, b: int): int {
    ^a + b
  }

  !deadMultiply(a: int, b: int): int {
    ^a * b
  }
}

mod DeadModule {
  !deadSecretHelper(): String {
    ^"DEAD_DATA"
  }
}

struct UsedPoint {
  x: int,
  y: int
}

struct DeadStruct {
  unusedField: int
}

enum UsedEnum {
  Valid,
  Invalid
}

enum DeadEnum {
  Alpha,
  Beta
}

use ActiveMath::{usedAdd};

!liveCompute(a: int, b: int): int {
  pt = UsedPoint { x: a, y: b };
  ^usedAdd(pt.x, pt.y)
}

!deadFunction(): String {
  ^"DEAD_FUNCTION"
}

=ex{liveCompute}
